    else if (item.type === 'range-responsive') control = buildRangeResponsiveRow(item);
    else if (item.type === 'select-custom') control = buildSelectCustomRow(item);
    else if (item.type === 'transition') control = buildTransitionRow(item);
    else control = { node: el('div', {}), reset: function () {} };

    container.appendChild(control.node);
    resetBtn.addEventListener('click', control.reset);
    registry[item.key + (item.type === 'range-responsive' ? '__resp' : '')] = { item: item, control: control, container: container };
    return container;
  }

  const header = el('header', { class: 'headerWrap' });
  const topBar = el('div', { class: 'topBar' });
  topBar.appendChild(el('h3', { style: 'margin:0; color:#10b981; font-size:18px; font-weight:800;', text: '히어로 대시보드' }));
  const topBtns = el('div', { style: 'display:flex; gap:8px; align-items:center;' });
  const themeBtn = el('button', { class: 'efh_themeBtn', text: '🌙 다크' });
  const resetAllBtn = el('button', { style: 'background:transparent; border:1px solid #444; color:#aaa; border-radius:6px; cursor:pointer; padding:6px 10px;', text: '전체 복구' });
  topBtns.appendChild(themeBtn); topBtns.appendChild(resetAllBtn);
  topBar.appendChild(topBtns);
  header.appendChild(topBar);

  const searchBox = el('input', { type: 'text', class: 'efh_searchBox', placeholder: '설정 검색 (예: 버튼, 색상, 닷, 전환)' });
  header.appendChild(searchBox);

  const storageBar = el('div', { class: 'efh_storageBar' });
  const saveBtn = el('button', { class: 'efh_storageBtn', text: '💾 임시저장(새 슬롯)' });
  const slotsToggleBtn = el('button', { class: 'efh_storageBtn', text: '📂 저장 슬롯 목록' });
  const invalidateBtn = el('button', { class: 'efh_storageBtn efh_storageBtnDanger', text: '↺ 기본값 보기(무효화)' });
  const exportTriggerBtn = el('button', { class: 'efh_storageBtn', text: '📤 코드 출력' });
  storageBar.appendChild(saveBtn); storageBar.appendChild(slotsToggleBtn); storageBar.appendChild(invalidateBtn); storageBar.appendChild(exportTriggerBtn);
  header.appendChild(storageBar);

  const statusEl = el('div', { class: 'efh_saveStatus' });
  header.appendChild(statusEl);

  const slotsPanel = el('div', { class: 'efh_slotsPanel', style: 'display:none;' });
  const slotsList = el('div', { style: 'display:flex; flex-direction:column; gap:6px;' });
  slotsPanel.appendChild(slotsList);
  header.appendChild(slotsPanel);

  const exportSection = el('div', { id: 'efh_exportSection', style: 'display:none; margin-top:4px; padding:14px; border:1px solid var(--efh-panel-border); background:var(--efh-summary-bg); border-radius:8px;' });
  const exportTextarea = el('textarea', { style: 'width:100%; height:280px; background:#000; color:#10b981; border:1px solid #444; border-radius:8px; padding:10px; font-family:monospace; font-size:12px; box-sizing:border-box; resize:vertical;' });
  const exportBtnRow = el('div', { style: 'display:flex; gap:10px; margin-top:10px;' });
  const copyBtn = el('button', { style: 'flex:1; padding:10px; background:#3b82f6; color:#fff; border:none; border-radius:6px; font-weight:800; cursor:pointer;', text: '기본 복사' });
  const copyMinBtn = el('button', { style: 'flex:1; padding:10px; background:#8b5cf6; color:#fff; border:none; border-radius:6px; font-weight:800; cursor:pointer;', text: '압축(Minify) 복사' });
  exportBtnRow.appendChild(copyBtn); exportBtnRow.appendChild(copyMinBtn);
  exportSection.appendChild(exportTextarea); exportSection.appendChild(exportBtnRow);
  header.appendChild(exportSection);

  app.appendChild(header);

  const main = el('main', { class: 'mainLayout' });
  qaConfig.forEach(function (groupObj) {
    const section = el('section', { class: 'panelSection', 'data-groupname': groupObj.group.toLowerCase() });
    const details = el('details', {}); details.open = true;
    const summary = el('summary', { class: 'efh_summary', text: groupObj.group });
    details.appendChild(summary);
    const body = el('div', { style: 'padding:0;' });
    groupObj.items.forEach(function (item) { body.appendChild(buildItem(item)); });
    details.appendChild(body);
    section.appendChild(details);
    main.appendChild(section);
  });

  const notionSection = el('section', { class: 'panelSection', 'data-groupname': '노션 연동 설정' });
  const notionDetails = el('details', {}); notionDetails.open = true;
  notionDetails.appendChild(el('summary', { class: 'efh_summary', style: 'color:#f43f5e;', text: '8. 노션 속성으로도 설정 가능한 항목' }));
  const notionBody = el('div', { style: 'padding:12px; display:flex; flex-direction:column; gap:10px;' });
  notionBody.appendChild(el('div', { style: 'font-size:11px; color:#888;', text: '아래 항목은 노션 테이블의 슬라이드 행에 값을 입력하면 그 슬라이드에만 개별 적용됩니다. 비워두면 위 대시보드 기본값이 사용됩니다.' }));
  NOTION_FIELDS.forEach(function (f) {
    const row = el('div', { style: 'background:var(--efh-summary-bg); padding:8px 10px; border-radius:6px;' });
    const rowTop = el('div', { style: 'display:flex; justify-content:space-between;' });
    rowTop.appendChild(el('span', { style: 'color:#eee; font-weight:700; font-size:12px;', text: f.label }));
    rowTop.appendChild(el('span', { class: 'efh_notionBadge', text: '노션 필드' }));
    row.appendChild(rowTop);
    row.appendChild(el('div', { style: 'font-size:11px; color:#888; margin-top:2px;', text: f.example + ' — ' + f.note }));
    notionBody.appendChild(row);
  });
  notionDetails.appendChild(notionBody);
  notionSection.appendChild(notionDetails);
  main.appendChild(notionSection);

  app.appendChild(main);

  const footer = el('footer', { style: 'padding:16px 20px; border-top:1px solid var(--efh-panel-border); background:var(--efh-panel-bg);' });
  footer.appendChild(el('div', { style: 'font-size:11px; color:#888; text-align:center;', text: '모든 변경사항은 즉시 페이지에 반영됩니다. 저장 슬롯을 눌러야 다음 방문 때도 남습니다.' }));
  app.appendChild(footer);

  searchBox.addEventListener('input', function () {
    const term = searchBox.value.trim().toLowerCase();
    D.querySelectorAll('.panelSection').forEach(function (sec) {
      const groupMatch = (sec.getAttribute('data-groupname') || '').includes(term);
      let any = false;
      sec.querySelectorAll('.efh_itemContainer').forEach(function (it) {
        const m = groupMatch || (it.getAttribute('data-label') || '').includes(term);
        it.style.display = (term === '' || m) ? '' : 'none';
        if (term === '' || m) any = true;
      });
      sec.style.display = (term === '' || any || groupMatch) ? '' : 'none';
    });
  });

  themeBtn.addEventListener('click', function () {
    const light = D.body.classList.toggle('efh_lightMode');
    themeBtn.textContent = light ? '☀️ 라이트' : '🌙 다크';
  });

  resetAllBtn.addEventListener('click', function () {
    if (!confirm('모든 설정을 기본값으로 되돌리시겠습니까?')) return;
    for (const k in registry) registry[k].control.reset();
  });

  function getSlots() { try { return JSON.parse(hostWin.localStorage.getItem(EFH_STORAGE_KEY)) || []; } catch (e) { return []; } }
  function setSlots(a) { hostWin.localStorage.setItem(EFH_STORAGE_KEY, JSON.stringify(a)); }
  function setStatus(msg) { statusEl.textContent = msg; setTimeout(function () { if (statusEl.textContent === msg) statusEl.textContent = ''; }, 4000); }

  function renderSlots() {
    slotsList.innerHTML = '';
    const slots = getSlots();
    if (slots.length === 0) { slotsList.appendChild(el('div', { style: 'font-size:11px; color:#888;', text: '저장된 슬롯이 없습니다.' })); return; }
    slots.slice().reverse().forEach(function (slot) {
      const row = el('div', { style: 'display:flex; gap:6px; align-items:center; background:var(--efh-summary-bg); padding:8px; border-radius:6px;' });
      row.appendChild(el('span', { style: 'flex:1; font-size:12px;', text: slot.label }));
      const loadBtn = el('button', { style: 'padding:5px 8px; background:#3b82f6; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:11px;', text: '불러오기' });
      const delBtn = el('button', { style: 'padding:5px 8px; background:#ef4444; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:11px;', text: '삭제' });
      loadBtn.addEventListener('click', function () { loadSlot(slot.id); });
      delBtn.addEventListener('click', function () { setSlots(getSlots().filter(function (s) { return s.id !== slot.id; })); renderSlots(); });
      row.appendChild(loadBtn); row.appendChild(delBtn);
      slotsList.appendChild(row);
    });
  }

  function loadSlot(id) {
    const slot = getSlots().find(function (s) { return s.id === id; });
    if (!slot) { setStatus('슬롯을 찾을 수 없습니다.'); return; }
    const p = slot.payload;
    for (const k in currentStyles) delete currentStyles[k];
    for (const k in p.styles || {}) currentStyles[k] = p.styles[k];
    applyCss();
    (p.toggles || []).forEach(function (t) {
      const reg = registry[t.key]; if (!reg) return;
      const input = reg.container.querySelector('.efh_toggleInput');
      if (input) { input.checked = t.checked; input.dispatchEvent(new Event('change')); }
    });
    (p.segmented || []).forEach(function (s) {
      const reg = registry[s.key]; if (!reg) return;
      reg.container.querySelectorAll('.efh_segBtn').forEach(function (b) { if (b.textContent === s.label) b.click(); });
    });
    (p.icons || []).forEach(function (ic) {
      const reg = registry[ic.key]; if (!reg || !reg.control.selectIcon) return;
      reg.control.selectIcon(ic.cls);
    });
    if (p.transition && registry['transitionStyle']) {
      const tReg = registry['transitionStyle'];
      const btns = tReg.container.querySelectorAll('.efh_segBtn');
      btns.forEach(function (b) { if (b.textContent === p.transition.styleLabel) b.click(); });
    }
    setStatus('"' + slot.label + '" 슬롯을 불러왔습니다.');
  }

  saveBtn.addEventListener('click', function () {
    const nowLabel = new Date().toLocaleString('ko-KR');
    const toggles = [], segmented = [], icons = [];
    for (const k in registry) {
      const reg = registry[k];
      const t = reg.container.querySelector('.efh_toggleInput');
      if (t) toggles.push({ key: k, checked: t.checked });
      const activeSeg = reg.container.querySelector('.efh_segBtn.efh_segActive');
      if (activeSeg && k !== 'transitionStyle') segmented.push({ key: k, label: activeSeg.textContent });
      const activeIcon = reg.container.querySelector('.efh_iconBtnActive i');
      if (activeIcon) icons.push({ key: k, cls: activeIcon.className });
    }
    let transition = null;
    if (registry['transitionStyle']) {
      const st = registry['transitionStyle'].control.getState();
      const styleLabel = registry['transitionStyle'].container.querySelector('.efh_segBtn.efh_segActive');
      transition = { styleLabel: styleLabel ? styleLabel.textContent : '페이드' };
    }
    const payload = { styles: JSON.parse(JSON.stringify(currentStyles)), toggles: toggles, segmented: segmented, icons: icons, transition: transition };
    const slots = getSlots();
    slots.push({ id: Date.now(), label: nowLabel + ' 저장', payload: payload });
    setSlots(slots);
    renderSlots();
    setStatus('새 슬롯으로 저장했습니다.');
  });

  slotsToggleBtn.addEventListener('click', function () {
    const open = slotsPanel.style.display !== 'none';
    slotsPanel.style.display = open ? 'none' : 'block';
    if (!open) renderSlots();
  });

  invalidateBtn.addEventListener('click', function () {
    if (!confirm('현재 미리보기 값을 지우고 엔진 기본값으로 되돌리시겠습니까? (저장된 슬롯은 유지됩니다)')) return;
    let dyn = hostWin.document.getElementById('efh_dynamic_dashboard_style');
    if (dyn) dyn.remove();
    for (const k in currentStyles) delete currentStyles[k];
    setStatus('엔진 기본값으로 복원했습니다.');
  });

  /* ================= 코드 출력 (Export) ================= */
  function getToggleChecked(key) { const r = registry[key]; return r ? !!r.container.querySelector('.efh_toggleInput').checked : null; }
  function getNumValue(key) { const r = registry[key]; if (!r) return null; const n = r.container.querySelector('.efh_inputNum'); return n ? n.value : null; }
  function getActiveSegValue(key) {
    const r = registry[key]; if (!r) return null;
    const btns = r.container.querySelectorAll('.efh_segBtn');
    const activeIdx = Array.prototype.findIndex.call(btns, function (b) { return b.classList.contains('efh_segActive'); });
    return activeIdx > -1 ? r.item.options[activeIdx][0] : r.item.def;
  }
  function getActiveIconClass(key) {
    const r = registry[key]; if (!r) return null;
    const activeI = r.container.querySelector('.efh_iconBtnActive i');
    return activeI ? activeI.className : r.item.def;
  }

  function buildExportCode() {
    let css = '<style>\n:root {\n';
    for (const k in currentStyles) css += '  ' + k + ': ' + currentStyles[k] + ' !important;\n';
    css += '}\n</style>';

    const lines = [];
    lines.push('<script>');
    lines.push('(function () {');
    lines.push('  function efhApplySavedSettings() {');
    lines.push('    if (!window.efhDashboardAPI) { setTimeout(efhApplySavedSettings, 200); return; }');

    if (getToggleChecked('pageTitleVisible') !== null) lines.push('    window.efhDashboardAPI.setPageTitleVisible(' + getToggleChecked('pageTitleVisible') + ');');
    if (getToggleChecked('pageTitleAreaVisible') !== null) lines.push('    window.efhDashboardAPI.setPageTitleAreaVisible(' + getToggleChecked('pageTitleAreaVisible') + ');');
    if (getToggleChecked('textShadow') !== null) lines.push('    document.querySelectorAll(".efh_hero_r1f").forEach(function (h) { h.setAttribute("data-textshadow", "' + (getToggleChecked('textShadow') ? '1' : '0') + '"); });');
    if (getToggleChecked('titleVisible') !== null) lines.push('    window.efhDashboardAPI.setTitleVisible(' + getToggleChecked('titleVisible') + ');');
    if (getToggleChecked('subtitleVisible') !== null) lines.push('    window.efhDashboardAPI.setSubtitleVisible(' + getToggleChecked('subtitleVisible') + ');');
    if (getNumValue('mobileBreakpoint') !== null) lines.push('    window.efhDashboardAPI.setMobileBreakpoint(' + JSON.stringify(getNumValue('mobileBreakpoint')) + ');');

    if (registry['transitionStyle']) {
      const st = registry['transitionStyle'].control.getState();
      lines.push('    window.efhDashboardAPI.setTransitionStyle(' + JSON.stringify(st.style) + ');');
      if (st.direction) lines.push('    window.efhDashboardAPI.setTransitionDirection(' + JSON.stringify(st.direction) + ');');
      if (st.mode) lines.push('    window.efhDashboardAPI.setContentMode(' + JSON.stringify(st.mode) + ');');
    }

    const shapeVal = getActiveSegValue('dotShape') || 'dot';
    if (shapeVal === 'icon') {
      lines.push('    window.efhDashboardAPI.setDotIcon(' + JSON.stringify(getActiveIconClass('dotIcon')) + ');');
    } else {
      lines.push('    window.efhDashboardAPI.setDotShape(' + JSON.stringify(shapeVal) + ');');
    }

    if (getToggleChecked('autoplay') !== null) lines.push('    window.efhDashboardAPI.setAutoplay(' + getToggleChecked('autoplay') + ');');
    if (getNumValue('defaultDuration') !== null) lines.push('    window.efhDashboardAPI.setDefaultSlideDuration(' + JSON.stringify(getNumValue('defaultDuration')) + ');');

    if (registry['scrollIcon']) lines.push('    window.efhDashboardAPI.setScrollIcon(' + JSON.stringify(getActiveIconClass('scrollIcon')) + ');');
    if (getToggleChecked('scrollVisible') !== null) lines.push('    document.querySelectorAll(".efh_scrollHint_g1d").forEach(function (el) { el.style.display = "' + (getToggleChecked('scrollVisible') ? '' : 'none') + '"; });');

    if (registry['pauseIcon'] || registry['playIcon']) {
      const pCls = registry['pauseIcon'] ? getActiveIconClass('pauseIcon') : 'fa-solid fa-circle-pause';
      const plCls = registry['playIcon'] ? getActiveIconClass('playIcon') : 'fa-solid fa-circle-play';
      lines.push('    window.efhDashboardAPI.setPauseIcons(' + JSON.stringify(pCls) + ', ' + JSON.stringify(plCls) + ');');
    }

    lines.push('  }');
    lines.push('  efhApplySavedSettings();');
    lines.push('})();');
    lines.push('<\/script>');

    return css + '\n\n' + lines.join('\n');
  }

  /* v9: 코드 출력 버튼 재클릭 시 안 닫히던 버그 수정 — boolean 상태로 관리 */
  let efhExportOpen = false;
  exportTriggerBtn.addEventListener('click', function () {
    efhExportOpen = !efhExportOpen;
    exportSection.style.display = efhExportOpen ? 'block' : 'none';
    if (efhExportOpen) exportTextarea.value = buildExportCode();
  });

  copyBtn.addEventListener('click', function () {
    exportTextarea.select();
    D.execCommand('copy');
    alert('코드가 복사되었습니다.');
  });

  copyMinBtn.addEventListener('click', function () {
    const raw = exportTextarea.value;
    const styleMatch = raw.match(/<style>[\s\S]*?<\/style>/);
    const scriptMatch = raw.match(/<script>[\s\S]*?<\/script>/);
    let minified = raw;
    if (styleMatch) {
      const minStyle = styleMatch[0].replace(/\n/g, '').replace(/\s{2,}/g, ' ');
      minified = minified.replace(styleMatch[0], minStyle);
    }
    if (scriptMatch) {
      const minScript = scriptMatch[0].replace(/\n\s*/g, ' ');
      minified = minified.replace(scriptMatch[0], minScript);
    }
    const temp = D.createElement('textarea');
    temp.value = minified;
    D.body.appendChild(temp);
    temp.select();
    D.execCommand('copy');
    D.body.removeChild(temp);
    alert('압축된 코드가 복사되었습니다.');
  });

  applyCss();
})();