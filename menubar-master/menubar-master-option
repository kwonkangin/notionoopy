    /* scrollEffect가 true일 때, 몇 px 이상 스크롤해야 효과가 발동되는지 정하는 임계값. 설정값: px 단위 숫자. 기본값 10 */
    "scrollThreshold": 10,
    /* 헤더가 fixed/sticky로 떠 있을 때, 본문 콘텐츠가 헤더에 가려지지 않도록 헤더 높이만큼 자동으로 상단 여백을 보정할지 여부. 설정값: true(자동 보정) / false(수동 처리 필요). 기본값 true */
    "offsetBody": true
};
</script>