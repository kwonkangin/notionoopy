    /* 헤더 좌우 안쪽 여백(패딩). 설정값: px 단위 숫자. 기본값 24px */
    --headerPaddingX_a5: 24px;
    /* 헤더의 쌓임 순서(z-index). 다른 요소 위에 항상 떠있게 하려면 값을 높게 설정. 설정값: 정수. 기본값 50 */
    --headerZIndex_a6: 50;
