            <button class="efc_resetSingleBtn_k2n" data-var="\${item.var}" data-def="\${item.def}" \${item.opVar ? \`data-opvar="\${item.opVar}" data-opdef="\${item.opDef}"\` : ''} title="초기값 복구" aria-label="\${item.label} 초기화">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
