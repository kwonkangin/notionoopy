          </div>\`;
        
        /* 폰트 제어를 위한 단일 색상 폼(투명도 제외) 렌더링 로직 추가 */
        if (item.type === 'color-opacity') {
          innerHTML += \`<div style="display:flex; gap:8px; align-items:center; width:100%;">
            <input type="color" class="efc_colorPicker_n5s" data-var="\${item.var}" value="\${rawVal}" aria-label="\${item.label} 색상 선택">
            <div style="display:flex; align-items:center; gap:4px; flex:1;">
              <span style="font-size:10px; color:#aaa;">투명도</span>
              <input type="range" class="efc_opacitySlider_m2z" data-var="\${item.opVar}" min="0" max="1" step="0.05" value="\${opRawVal}" style="flex:1; accent-color:#10b981; height:4px;" aria-label="\${item.label} 투명도 조절">
              <span style="font-size:11px; color:#10b981; width:24px; text-align:right;" class="efc_opLabel_k9n">\${opRawVal}</span>
            </div>
            <input type="text" class="efc_colorTxt_m8r" data-var="\${item.var}" value="\${rawVal}" style="width:70px;" aria-label="\${item.label} 텍스트 입력">
          </div>\`;
        } else if (item.type === 'color') {
          innerHTML += \`<div style="display:flex; gap:8px; align-items:center; width:100%;">
            <input type="color" class="efc_colorPicker_n5s" data-var="\${item.var}" value="\${rawVal}" aria-label="\${item.label} 색상 선택">
