      let cssRules = ':root {\\n';
      for(let key in window.efc_currentStyles_v9b) {
          cssRules += \`  \${key}: \${window.efc_currentStyles_v9b[key]} !important;\\n\`;
      }
      cssRules += '}';
      styleTag.innerHTML = cssRules;

      /* 논리 판단이 필요한 속성은 HTML data 속성으로 변환하여 부모창에 새깁니다. */
      if (['--tg-mode', '--tg-use-icon-auto-size', '--tg-color-theme', '--tg-use-hover', '--tg-use-custom-icon-color', '--tg-co-sync', '--tg-icon-transform', '--tg-use-custom-font'].includes(v)) {
          let attrName = v.replace('--tg-use-', 'data-tg-').replace('--tg-', 'data-tg-');
          if(v === '--tg-use-icon-auto-size') attrName = 'data-tg-icon-auto';
          if(v === '--tg-use-custom-icon-color') attrName = 'data-tg-custom-icon';
          window.opener.document.documentElement.setAttribute(attrName, val);
      }
    };

    /* 폰트어썸 정규식 추출 및 시각적 피드백 제공 함수 */
    const efc_extractClass_e4x = (str) => {
        const match = str.match(/class=["']([^"']+)["']/i);
        return match ? match[1].trim() : str.replace(/['"]/g, '').trim();
    };

    const efc_applyFaIcons_a5y = (cVal, oVal) => {
        const cleanC = efc_extractClass_e4x(cVal);
        const cleanO = efc_extractClass_e4x(oVal);
        
        document.getElementById('inpC').value = cleanC;
        document.getElementById('inpO').value = cleanO;
        
        efc_applyChange_p9m('--tg-fa-closed', "'" + cleanC + "'");
        efc_applyChange_p9m('--tg-fa-opened', "'" + cleanO + "'");
        
        const msgDiv = document.getElementById('efc_faResultMsg_r2c');
        msgDiv.innerText = "적용 완료 되었습니다 " + cleanC + " 과 " + cleanO;
        setTimeout(() => { msgDiv.innerText = ""; }, 4000);
    };

    document.getElementById('efc_applyFaBtn_a1b').addEventListener('click', () => {
        const cVal = document.getElementById('inpC').value || 'fa-solid fa-chevron-right';
        const oVal = document.getElementById('inpO').value || 'fa-solid fa-chevron-down';
        efc_applyFaIcons_a5y(cVal, oVal);
    });

    document.querySelectorAll('.efc_iconPairBtn_i7p').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.efc_iconPairBtn_i7p').forEach(b => b.style.borderColor = '#444');
        e.currentTarget.style.borderColor = '#10b981';
        
        const cVal = e.currentTarget.getAttribute('data-close');
        const oVal = e.currentTarget.getAttribute('data-open');
        document.getElementById('inpC').value = cVal;
        document.getElementById('inpO').value = oVal;
      });
    });

    document.querySelectorAll('.efc_colorPicker_n5s, .efc_opacitySlider_m2z, .efc_colorTxt_m8r').forEach(input => {
      input.addEventListener('input', (e) => {
        const container = e.target.closest('div.efc_itemContainer_j3v');
        const v = container.querySelector('.efc_colorPicker_n5s').getAttribute('data-var');
        const opV = container.querySelector('.efc_opacitySlider_m2z') ? container.querySelector('.efc_opacitySlider_m2z').getAttribute('data-var') : null;
        let picker = container.querySelector('.efc_colorPicker_n5s');
        let slider = container.querySelector('.efc_opacitySlider_m2z');
        let txt = container.querySelector('.efc_colorTxt_m8r');
        let lbl = container.querySelector('.efc_opLabel_k9n');

        if(e.target.classList.contains('efc_colorTxt_m8r')) {
           picker.value = e.target.value;
           efc_applyChange_p9m(v, e.target.value);
        } else if(e.target.classList.contains('efc_colorPicker_n5s')) {
           txt.value = picker.value;
           efc_applyChange_p9m(v, picker.value);
        } else if(e.target.classList.contains('efc_opacitySlider_m2z') && opV) {
           lbl.innerText = slider.value;
           efc_applyChange_p9m(opV, slider.value);
        }
      });
    });

    document.querySelectorAll('.efc_inputRange_x8p, .efc_inputNum_c4m').forEach(input => {
      input.addEventListener('input', (e) => {
        const v = e.target.getAttribute('data-var');
        const unit = e.target.getAttribute('data-unit');
        let val = e.target.value;
        if (e.target.classList.contains('efc_inputRange_x8p')) { e.target.nextElementSibling.value = val; } 
        else { e.target.previousElementSibling.value = val; }
        efc_applyChange_p9m(v, val + unit);
      });
    });

    document.querySelectorAll('.efc_basicSel_h7k').forEach(input => {
      input.addEventListener('input', (e) => efc_applyChange_p9m(e.target.getAttribute('data-var'), e.target.value));
    });

    document.querySelectorAll('.efc_resetSingleBtn_k2n').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const btnEl = e.currentTarget;
        const v = btnEl.getAttribute('data-var'); 
        const def = btnEl.getAttribute('data-def');
        const opV = btnEl.getAttribute('data-opvar');
        const opDef = btnEl.getAttribute('data-opdef');
        
        efc_applyChange_p9m(v, def);
        if(opV) efc_applyChange_p9m(opV, opDef);
        
        const container = btnEl.closest('.efc_itemContainer_j3v');
        container.querySelectorAll('input, select').forEach(inp => {
          if (inp.classList.contains('efc_colorPicker_n5s') || inp.classList.contains('efc_colorTxt_m8r') || inp.classList.contains('efc_basicSel_h7k')) { 
            inp.value = def; 
          } else if(inp.classList.contains('efc_opacitySlider_m2z') && opDef) {
            inp.value = opDef;
            container.querySelector('.efc_opLabel_k9n').innerText = opDef;
          } else if(inp.classList.contains('efc_inputRange_x8p') || inp.classList.contains('efc_inputNum_c4m')) {
            inp.value = parseFloat(def) || 0;
          }
        });
      });
    });

    document.getElementById('efc_globalResetBtn_x2k').addEventListener('click', () => {
      if(confirm('모든 설정을 초기화하시겠습니까?')) { document.querySelectorAll('.efc_resetSingleBtn_k2n').forEach(btn => btn.click()); }
    });

    /* CSS 코드 추출 및 클립보드 복사 렌더링 로직 */
    const efc_generateExportCode_m3p = () => {
      let exportText = ":root {\\n";
      qaConfig.forEach(g => g.items.forEach(i => { 
        if(i.var) exportText += \`  \${i.var}: \${window.efc_currentStyles_v9b[i.var] || i.def};\\n\`; 
        if(i.opVar) exportText += \`  \${i.opVar}: \${window.efc_currentStyles_v9b[i.opVar] || i.opDef};\\n\`; 
      }));
      
      let closeVal = document.getElementById('inpC') ? document.getElementById('inpC').value : 'fa-solid fa-chevron-right';
      let openVal = document.getElementById('inpO') ? document.getElementById('inpO').value : 'fa-solid fa-chevron-down';
      exportText += \`  --tg-fa-closed: '\${closeVal}';\\n\`;
      exportText += \`  --tg-fa-opened: '\${openVal}';\\n\`;
      exportText += "}";
      return exportText;
    };

    document.getElementById('efc_exportTriggerBtn_j2m').addEventListener('click', () => {
      const finalCode = efc_generateExportCode_m3p();
      document.getElementById('efc_exportTextarea_f4v').value = finalCode;
      
      const area = document.getElementById('efc_exportArea_w9c');
      area.style.display = area.style.display === 'none' ? 'block' : 'none';
      if(area.style.display === 'block') {
          area.scrollIntoView({behavior: "smooth"});
      }
    });

    document.getElementById('efc_copyBtn_l8x').addEventListener('click', () => {
      document.getElementById('efc_exportTextarea_f4v').select(); document.execCommand('copy'); alert('안전하게 복사되었습니다.');
    });
  `;

  popup.document.open();
  popup.document.write(`
  <!DOCTYPE html>
