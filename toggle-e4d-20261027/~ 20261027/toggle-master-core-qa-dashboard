      .panelSection_p9s.visible_v0v { opacity: 1; transform: translateY(0); }
      .efc_itemContainer_j3v { display: flex; flex-direction: column; gap: 6px; padding-bottom: 8px; border-bottom: 1px dashed #333; }
      .efc_resetSingleBtn_k2n { display: flex; align-items: center; justify-content: center; background: transparent; border: none; color: #888; cursor: pointer; padding: 4px; transition: color 0.2s; }
