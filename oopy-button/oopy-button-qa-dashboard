            <div>
                <div class="inputGroup_i2g">
                    <label class="inputLabel_l3l">아이콘 방향 (IP)</label>
                    <select class="selectInput_s5s efc_inpIp_i1e" aria-label="아이콘 방향">
                        <option value="L">Left (문구 왼쪽)</option>
                        <option value="R">Right (문구 오른쪽)</option>
                        <option value="T">Top (문구 위쪽)</option>
                        <option value="B">Bottom (문구 아래쪽)</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="inputGroup_i2g" style="margin-top:10px;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color_b5e); padding-bottom:10px;">
                <label class="inputLabel_l3l" style="margin:0;">아이콘 보관함 (즐겨찾기 드래그 앤 드롭 지원)</label>
                <button class="primaryBtn_p1b efc_addIconBtn_a2f" aria-label="현재 아이콘 즐겨찾기 추가">현재 아이콘 즐겨찾기에 추가</button>
            </div>
            <div class="iconGridWrap_i1w efc_iconGrid_i3g"></div>
            <button class="primaryBtn_p1b efc_moreIconsBtn_m4h" style="margin-top:12px; background:var(--bg-main_b1a); color:var(--text-main_t3c); border:1px solid var(--border-color_b5e); width:100%;" aria-label="나머지 아이콘 불러오기">나머지 40개 아이콘 불러오기</button>
        </div>
    </section>

    <section class="panelSection_p9s efc_observerSec_o6f" style="grid-column: 1 / -1;">
        <h2 class="panelTitle_p1t">5. 숏코드 출력 및 복사</h2>
        
        <label class="inputLabel_l3l" style="margin-bottom: 8px;">표준 숏코드 (안정적인 양식)</label>
        <div class="codeWrap_c6w">
            <textarea class="codeArea_c7a efc_outFull_o5i" spellcheck="false" aria-label="표준 숏코드 결과"></textarea>
            <button class="copyIconBtn_c8b efc_copyFullBtn_c6j" aria-label="표준 숏코드 복사" title="복사하기"><i class="fas fa-copy"></i></button>
        </div>

        <label class="inputLabel_l3l" style="margin-bottom: 8px;">스마트 압축 숏코드 (이름표 필수 방식)</label>
        <div class="codeWrap_c6w">
            <textarea class="codeArea_c7a efc_outCompact_o7k" spellcheck="false" aria-label="압축 숏코드 결과"></textarea>
            <button class="copyIconBtn_c8b efc_copyCompactBtn_c8l" aria-label="압축 숏코드 복사" title="복사하기"><i class="fas fa-copy"></i></button>
        </div>

        <!-- 새롭게 추가된 순서 기반 축약 숏코드 양식 -->
        <label class="inputLabel_l3l" style="margin-bottom: 8px;">순서 기반 축약 숏코드 (이름표 생략, 빈칸 유지)</label>
        <div class="codeWrap_c6w" style="margin-bottom: 0;">
            <textarea class="codeArea_c7a efc_outPositional_o8p" spellcheck="false" aria-label="순서 기반 축약 숏코드 결과"></textarea>
            <button class="copyIconBtn_c8b efc_copyPositionalBtn_c9q" aria-label="순서 기반 숏코드 복사" title="복사하기"><i class="fas fa-copy"></i></button>
        </div>
    </section>
</main>

<div class="toastBox_t9b efc_toastBox_t9m">숏코드가 클립보드에 복사되었습니다!</div>

<script>
/* 
  =========================================================================
  숏코드 대시보드 로직 제어 자바스크립트
  =========================================================================
*/
document.addEventListener('DOMContentLoaded', function efc_initDashboardLogic() {
    'use strict';

    /* DOM 식별자 맵핑 */
    var els = {
        themeChk: document.querySelector('.efc_themeToggle_t1a'), bgCol: document.querySelector('.efc_bgColor_b2b'),
        bgOp: document.querySelector('.efc_bgOpacity_b3c'), canvas: document.querySelector('.efc_canvasArea_c4d'),
        mockBtn: document.querySelector('.efc_mockBtn_m5e'),
        txt: document.querySelector('.efc_inpTxt_i7g'), url: document.querySelector('.efc_inpUrl_i8h'),
        w: document.querySelector('.efc_inpW_i9i'), hoverChk: document.querySelector('.efc_hoverToggle_h0j'),
        rSlide: document.querySelector('.efc_rSlide_r9s'), rNum: document.querySelector('.efc_rNum_r0t'),
        bcPick: document.querySelector('.efc_bcPick_p1k'), bcTxt: document.querySelector('.efc_bcTxt_t2l'),
        tcPick: document.querySelector('.efc_tcPick_p3m'), tcTxt: document.querySelector('.efc_tcTxt_t4n'),
        hbcPick: document.querySelector('.efc_hbcPick_p5o'), hbcTxt: document.querySelector('.efc_hbcTxt_t6p'),
        htcPick: document.querySelector('.efc_htcPick_p7q'), htcTxt: document.querySelector('.efc_htcTxt_t8r'),
        fsToggle: document.querySelector('.efc_fsToggle_f1u'), fsSlide: document.querySelector('.efc_fsSlide_f2v'), fsNum: document.querySelector('.efc_fsNum_f3w'),
        fwToggle: document.querySelector('.efc_fwToggle_f4x'), fwSlide: document.querySelector('.efc_fwSlide_f5y'), fwNum: document.querySelector('.efc_fwNum_f6z'),
        isToggle: document.querySelector('.efc_isToggle_i7a'), isSlide: document.querySelector('.efc_isSlide_i8b'), isNum: document.querySelector('.efc_isNum_i9c'),
        ic: document.querySelector('.efc_inpIc_i0d'), ip: document.querySelector('.efc_inpIp_i1e'),
        iconGrid: document.querySelector('.efc_iconGrid_i3g'), addIconBtn: document.querySelector('.efc_addIconBtn_a2f'), moreIconsBtn: document.querySelector('.efc_moreIconsBtn_m4h'),
        
        outFull: document.querySelector('.efc_outFull_o5i'), 
        outCompact: document.querySelector('.efc_outCompact_o7k'),
        outPositional: document.querySelector('.efc_outPositional_o8p'), /* 추가된 요소 매핑 */
        
        copyFull: document.querySelector('.efc_copyFullBtn_c6j'), 
        copyCompact: document.querySelector('.efc_copyCompactBtn_c8l'),
        copyPositional: document.querySelector('.efc_copyPositionalBtn_c9q'), /* 추가된 요소 매핑 */
        toast: document.querySelector('.efc_toastBox_t9m')
    };

    /* 기초 데이터 및 로컬 상태 구조 */
    var defaultIcons = [
        "fa-solid fa-house","fa-solid fa-link","fa-solid fa-arrow-right","fa-solid fa-check","fa-solid fa-download",
        "fa-solid fa-cart-shopping","fa-solid fa-magnifying-glass","fa-solid fa-envelope","fa-solid fa-user","fa-solid fa-star",
        "fa-solid fa-bell","fa-solid fa-gear","fa-solid fa-pen","fa-solid fa-trash","fa-solid fa-camera",
        "fa-solid fa-video","fa-solid fa-music","fa-solid fa-play","fa-solid fa-pause","fa-solid fa-stop",
        "fa-solid fa-forward","fa-solid fa-backward","fa-solid fa-image","fa-solid fa-share","fa-solid fa-reply",
        "fa-solid fa-comment","fa-solid fa-heart","fa-solid fa-thumbs-up","fa-solid fa-thumbs-down","fa-solid fa-flag",
        "fa-solid fa-bookmark","fa-solid fa-calendar","fa-solid fa-clock","fa-solid fa-globe","fa-solid fa-location-dot",
        "fa-solid fa-phone","fa-solid fa-mobile","fa-solid fa-desktop","fa-solid fa-laptop","fa-solid fa-tablet",
        "fa-solid fa-wifi","fa-solid fa-bluetooth","fa-solid fa-battery-full","fa-solid fa-power-off","fa-solid fa-lock",
        "fa-solid fa-unlock","fa-solid fa-key","fa-solid fa-shield","fa-solid fa-award","fa-solid fa-gift"
    ];
    var customIconsArr = JSON.parse(localStorage.getItem('ep_icons_v11') || '[]');
    var isAllIconsVisible = false;
    var dragSourceIndex = null;

    /* 교차 관찰자 기능 패널 페이드인 스크롤 애니메이션 추가 */
    var sectionObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible_v0v');
                sectionObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });
    
    document.querySelectorAll('.efc_observerSec_o6f').forEach(function(sec) {
        sectionObserver.observe(sec);
    });

    /* 아이콘 목록 UI 생성 논리 */
    function efc_drawIcons() {
        els.iconGrid.innerHTML = '';
        var top10List = defaultIcons.slice(0, 10);
        var rest40List = defaultIcons.slice(10);
        
        function appendTitle(msg) {
            var el = document.createElement('div');
            el.className = 'sectionDiv_s5d';
            el.textContent = msg;
            els.iconGrid.appendChild(el);
        }

        if(customIconsArr.length > 0) appendTitle('내 즐겨찾기 (드래그하여 순서 변경)');
        
        customIconsArr.forEach(function(iconCls, idx) {
            var div = document.createElement('div');
            div.className = 'iconCell_i2c draggable_d3d';
            div.title = iconCls;
            div.draggable = true;
            div.innerHTML = '<i class="' + iconCls + '"></i>';
            
            var delBtn = document.createElement('div');
            delBtn.className = 'deleteBtn_d4b';
            delBtn.innerHTML = '<i class="fas fa-times"></i>';
            delBtn.onclick = function(ev) {
                ev.stopPropagation();
                customIconsArr.splice(idx, 1);
                localStorage.setItem('ep_icons_v11', JSON.stringify(customIconsArr));
                efc_drawIcons();
            };
            div.appendChild(delBtn);
            div.onclick = function() { els.ic.value = iconCls; efc_syncData(); };
            
            div.addEventListener('dragstart', function(ev) { dragSourceIndex = idx; });
            div.addEventListener('dragover', function(ev) { ev.preventDefault(); });
            div.addEventListener('drop', function(ev) {
                ev.preventDefault();
                if(dragSourceIndex !== null && dragSourceIndex !== idx) {
                    var movedItem = customIconsArr.splice(dragSourceIndex, 1)[0];
                    customIconsArr.splice(idx, 0, movedItem);
                    localStorage.setItem('ep_icons_v11', JSON.stringify(customIconsArr));
                    efc_drawIcons();
                }
            });
            els.iconGrid.appendChild(div);
        });

        appendTitle('자주 쓰는 아이콘 상위 10개');
        top10List.forEach(function(iconCls) {
            var div = document.createElement('div');
            div.className = 'iconCell_i2c';
            div.title = iconCls;
            div.innerHTML = '<i class="' + iconCls + '"></i>';
            div.onclick = function() { els.ic.value = iconCls; efc_syncData(); };
            els.iconGrid.appendChild(div);
        });

        if (isAllIconsVisible) {
            appendTitle('나머지 기본 아이콘 40개');
            rest40List.forEach(function(iconCls) {
                var div = document.createElement('div');
                div.className = 'iconCell_i2c';
                div.title = iconCls;
                div.innerHTML = '<i class="' + iconCls + '"></i>';
                div.onclick = function() { els.ic.value = iconCls; efc_syncData(); };
                els.iconGrid.appendChild(div);
            });
        }
        
        els.moreIconsBtn.style.display = isAllIconsVisible ? 'none' : 'block';
    }
    
    els.moreIconsBtn.onclick = function() { isAllIconsVisible = true; efc_drawIcons(); };

    els.addIconBtn.onclick = function() {
        var val = els.ic.value.trim();
        if (val && customIconsArr.indexOf(val) === -1) {
            customIconsArr.unshift(val);
            localStorage.setItem('ep_icons_v11', JSON.stringify(customIconsArr));
            efc_drawIcons();
        }
    };

    /* 미리보기 배경 제어 로직 */
    function efc_handleBgColor() {
        if (els.themeChk.checked) els.bgCol.value = '#ffffff';
        else els.bgCol.value = '#121212';
        efc_paintCanvas();
    }
    function efc_paintCanvas() {
        var hex = els.bgCol.value;
        var r = parseInt(hex.slice(1,3), 16), g = parseInt(hex.slice(3,5), 16), b = parseInt(hex.slice(5,7), 16);
        els.canvas.style.backgroundColor = 'rgba(' + r + ',' + g + ',' + b + ',' + els.bgOp.value + ')';
    }
    els.themeChk.addEventListener('change', efc_handleBgColor);
    els.bgCol.addEventListener('input', efc_paintCanvas);
    els.bgOp.addEventListener('input', efc_paintCanvas);

    /* 양방향 바인딩 지원 유틸리티 */
    function efc_bindSlider(slider, num) {
        slider.addEventListener('input', function() { num.value = slider.value; efc_syncData(); });
        num.addEventListener('input', function() { slider.value = num.value; efc_syncData(); });
    }
    function efc_bindColor(pick, txt) {
        pick.addEventListener('input', function() { txt.value = pick.value; efc_syncData(); });
        txt.addEventListener('input', function() { if(/^#[0-9A-Fa-f]{6}$/i.test(txt.value)) pick.value = txt.value; efc_syncData(); });
    }
    function efc_bindToggle(toggle, slider, num) {
        toggle.addEventListener('change', function() {
            var active = toggle.checked;
            slider.disabled = !active;
            num.disabled = !active;
            efc_syncData();
        });
    }

    efc_bindSlider(els.rSlide, els.rNum);
    efc_bindSlider(els.fsSlide, els.fsNum);
    efc_bindSlider(els.fwSlide, els.fwNum);
    efc_bindSlider(els.isSlide, els.isNum);
    efc_bindColor(els.bcPick, els.bcTxt);
    efc_bindColor(els.tcPick, els.tcTxt);
    efc_bindColor(els.hbcPick, els.hbcTxt);
    efc_bindColor(els.htcPick, els.htcTxt);
    efc_bindToggle(els.fsToggle, els.fsSlide, els.fsNum);
    efc_bindToggle(els.fwToggle, els.fwSlide, els.fwNum);
    efc_bindToggle(els.isToggle, els.isSlide, els.isNum);

    /* HTML 태그 자동 정제 */
    els.ic.addEventListener('input', function() {
        var match = els.ic.value.match(/class=["']([^"']+)["']/i);
        if (match) els.ic.value = match[1];
        efc_syncData();
    });

    [els.txt, els.url, els.w, els.ip, els.hoverChk].forEach(function(el) {
        el.addEventListener('input', efc_syncData);
        el.addEventListener('change', efc_syncData);
    });

    /* 실시간 화면 출력 및 스마트 숏코드 압축 로직 */
    function efc_syncData() {
        var valTxt = els.txt.value || '버튼';
        var valUrl = els.url.value || '#';
        var valIc = els.ic.value;
        var valIp = els.ip.value;
        var valIs = els.isToggle.checked ? els.isNum.value : '';
        var valW = els.w.value;
        var valR = els.rNum.value;
        var valBc = els.bcTxt.value;
        var valTc = els.tcTxt.value;
        var valHbc = els.hoverChk.checked ? 'none' : els.hbcTxt.value;
        var valHtc = els.htcTxt.value;
        var valFs = els.fsToggle.checked ? els.fsNum.value : '';
        var valFw = els.fwToggle.checked ? els.fwNum.value : '';

        var dirVal = 'row';
        if(valIp === 'R') dirVal = 'row-reverse';
        if(valIp === 'T') dirVal = 'column';
        if(valIp === 'B') dirVal = 'column-reverse';
        
        var sc = valHbc === 'none' ? '1' : '1.03';
        var shd = valHbc === 'none' ? '0 4px 15px rgba(0, 0, 0, 0.06)' : '0 6px 20px rgba(0, 0, 0, 0.12)';
        
        els.mockBtn.style.setProperty('--btn-bg', valBc);
        els.mockBtn.style.setProperty('--btn-color', valTc);
        els.mockBtn.style.setProperty('--btn-w', valW === 'W' ? '100%' : 'fit-content');
        if(valW === 'W') els.mockBtn.classList.add('full-width'); else els.mockBtn.classList.remove('full-width');
        els.mockBtn.style.setProperty('--btn-rad', valR + 'px');
        els.mockBtn.style.setProperty('--btn-h-bg', valHbc === 'none' ? valBc : valHbc);
        els.mockBtn.style.setProperty('--btn-h-color', valHbc === 'none' ? valTc : valHtc);
        els.mockBtn.style.setProperty('--btn-h-scale', sc);
        els.mockBtn.style.setProperty('--btn-h-shadow', shd);
        els.mockBtn.style.setProperty('--btn-fs', valFs ? valFs + 'px' : '16px');
        els.mockBtn.style.setProperty('--btn-fw', valFw ? valFw : '700');
        els.mockBtn.style.setProperty('--btn-dir', dirVal);
        els.mockBtn.style.setProperty('--btn-is', valIs ? valIs + 'px' : '1.2em');

        els.mockBtn.innerHTML = '';
        if (valIc && valIc !== 'none') {
            if (valIc.indexOf('http') === 0 || valIc.indexOf('/') === 0) {
                els.mockBtn.innerHTML += '<img src="' + valIc + '" class="ga-btn-icon_k9m" alt="보조 이미지">';
            } else {
                els.mockBtn.innerHTML += '<i class="' + valIc + ' ga-btn-icon_k9m" aria-hidden="true"></i>';
            }
        }
        els.mockBtn.innerHTML += '<span>' + valTxt + '</span>';

        /* 1. 표준 숏코드 포맷 생성 */
        var outFull = `[% button | TXT ${valTxt} | URL ${valUrl} | IC ${valIc} | IP ${valIp} | IS ${valIs} | W ${valW} | R ${valR} | BC ${valBc} | TC ${valTc} | HBC ${valHbc} | HTC ${valHtc} | FS ${valFs} | FW ${valFw} %]`;
        
        /* 2. 옵션 A: 공백과 불필요한 값을 모두 지운 스마트 압축 포맷 생성 */
        var compactParts = [`TXT ${valTxt}`, `URL ${valUrl}`];
        if (valIc) compactParts.push(`IC ${valIc}`);
        if (valIp !== 'L') compactParts.push(`IP ${valIp}`);
        if (valIs) compactParts.push(`IS ${valIs}`);
        if (valW !== 'w') compactParts.push(`W ${valW}`);
        if (valR !== '14') compactParts.push(`R ${valR}`);
        if (valBc !== '#FF4500') compactParts.push(`BC ${valBc}`);
        if (valTc !== '#ffffff') compactParts.push(`TC ${valTc}`);
        if (valHbc !== valBc && valHbc !== '') compactParts.push(`HBC ${valHbc}`);
        if (valHtc !== valTc && valHtc !== '') compactParts.push(`HTC ${valHtc}`);
        if (valFs) compactParts.push(`FS ${valFs}`);
        if (valFw) compactParts.push(`FW ${valFw}`);
        
        var outCompact = `[% button | ${compactParts.join(' | ')} %]`;

        /* 3. 새롭게 추가된 기능: 이름표를 지우고 빈칸을 강제 유지하는 13슬롯 순서 기반 축약 양식 */
        var outPositional = `[% button | ${valTxt} | ${valUrl} | ${valIc} | ${valIp} | ${valIs} | ${valW} | ${valR} | ${valBc} | ${valTc} | ${valHbc} | ${valHtc} | ${valFs} | ${valFw} %]`;
        /* 뒤쪽의 비어있는 슬롯을 깔끔하게 정리하는 선택적 정규식 로직 추가 가능하지만, 
           요청하신 13자리 빈 공간 유지를 위해 그대로 출력합니다. */

        els.outFull.value = outFull;
        els.outCompact.value = outCompact;
        els.outPositional.value = outPositional;
    }

    /* 폼 검증 기반 가짜 제출 함수 모의 로직 */
    function efc_validateAndCopy(textarea) {
        var urlCheck = els.url.value.trim();
        if(!/^https?:\/\//i.test(urlCheck) && urlCheck !== '#' && urlCheck !== 'none') {
            console.warn('[데이터 검증 알림] URL 형식이 안전하지 않습니다. 프로토콜(http)이 누락되었습니다.');
        } else {
            console.log('[모의 제출 성공] 데이터 추출 완료:', textarea.value);
        }
        
        textarea.select();
        document.execCommand('copy');
        els.toast.classList.add('show_s0s');
        setTimeout(function() { els.toast.classList.remove('show_s0s'); }, 2500);
    }
    
    els.copyFull.onclick = function() { efc_validateAndCopy(els.outFull); };
    els.copyCompact.onclick = function() { efc_validateAndCopy(els.outCompact); };
    els.copyPositional.onclick = function() { efc_validateAndCopy(els.outPositional); };

    efc_drawIcons();
    efc_syncData();
});
</script>
</body>
</html>