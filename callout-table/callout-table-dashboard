    function ctd_extractCssVars_h2f(text) {
      const rootIdx = text.indexOf(':root');
      if (rootIdx === -1) return {};
      const braceStart = text.indexOf('{', rootIdx);
      if (braceStart === -1) return {};
      let depth = 0, i = braceStart;
      for (; i < text.length; i++) { if (text[i]==='{') depth++; else if (text[i]==='}') { depth--; if (depth===0) { i++; break; } } }
      const block = text.substring(braceStart, i);
      const map = {};
      const re = /(--[a-zA-Z0-9_-]+)\\s*:\\s*([^;]+);/g;
      let m;
      while ((m = re.exec(block)) !== null) map[m[1].trim()] = m[2].trim().replace(/\\s*!important\\s*$/,'');
      return map;
    }
