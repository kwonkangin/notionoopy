  /* ================= 색상/보더/패딩/전환 파싱-합성 유틸 ================= */

  function hexToRgb(hex) {
    let c = hex.replace('#', '');
    if (c.length === 3) c = c.split('').map(x => x + x).join('');
    return { r: parseInt(c.substr(0, 2), 16), g: parseInt(c.substr(2, 2), 16), b: parseInt(c.substr(4, 2), 16) };
  }
  function rgbToHex(r, g, b) {
    const h = n => Math.max(0, Math.min(255, n)).toString(16).padStart(2, '0');
    return '#' + h(r) + h(g) + h(b);
  }
  function composeRgba(hex, alphaPct) {
    const rgb = hexToRgb(hex);
    return 'rgba(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ', ' + (parseFloat(alphaPct) / 100).toFixed(2) + ')';
  }
  function parseColorAny(str) {
    if (!str || str === 'none' || str === 'transparent') return { hex: '#ffffff', alphaPct: 0 };
    const m = str.match(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)/);
    if (m) {
      const r = parseInt(m[1], 10), g = parseInt(m[2], 10), b = parseInt(m[3], 10);
      const a = m[4] !== undefined ? parseFloat(m[4]) : 1;
      return { hex: rgbToHex(r, g, b), alphaPct: Math.round(a * 100) };
    }
    if (HEX_REGEX.test(str)) return { hex: str, alphaPct: 100 };
    return { hex: '#000000', alphaPct: 100 };
  }
  function parseBorderStr(str) {
    if (!str || str === 'none') return { width: 1, hex: '#373530', alphaPct: 0 };
    const m = str.match(/^([\d.]+)px\s+solid\s+(.+)$/);
    if (!m) return { width: 1, hex: '#373530', alphaPct: 0 };
    const color = parseColorAny(m[2].trim());
    return { width: parseFloat(m[1]), hex: color.hex, alphaPct: color.alphaPct };
  }
  function composeBorderStr(width, hex, alphaPct) {
    return width + 'px solid ' + composeRgba(hex, alphaPct);
  }
  function parsePaddingStr(str) {
    const parts = (str || '0px').trim().split(/\s+/).map(p => parseFloat(p) || 0);
    let t, r, b, l;
    if (parts.length === 1) { t = r = b = l = parts[0]; }
    else if (parts.length === 2) { t = b = parts[0]; r = l = parts[1]; }
    else if (parts.length === 3) { t = parts[0]; r = l = parts[1]; b = parts[2]; }
    else { t = parts[0]; r = parts[1]; b = parts[2]; l = parts[3]; }
    return { t, r, b, l };
  }
  function composePaddingStr(t, r, b, l) {
    if (t === b && r === l) return t + 'px ' + r + 'px';
    return t + 'px ' + r + 'px ' + b + 'px ' + l + 'px';
  }
  function parseTransitionStr(str) {
    const m = (str || '160ms ease').match(/^(\d+)ms\s+(.+)$/);
    if (!m) return { duration: 160, easing: 'ease' };
    return { duration: parseInt(m[1], 10), easing: m[2].trim() };
