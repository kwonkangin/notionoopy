    GROUPS.forEach(g => { sectionsHtml += renderSection(g); });

    return '<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8"><title>Notion 탭 엔진 대시보드 v15</title><style>' + CSS_TEXT + '</style></head><body>' +
