  function buildItemWrapper(labelHtml, innerHtml, resetVar) {
    let html = '<div class="itemBox">';
    if (labelHtml) {
      html += '<div class="itemHead">' + labelHtml +
        '<button class="resetBtn" data-resetvar="' + (resetVar || '') + '" title="기본값으로">' +
