  }

  /* ================= 렌더 + 이벤트 바인딩 ================= */

  function renderAll() {
    const pdoc = popupWindow.document;
    const scrollTop = pdoc.getElementById('mainArea') ? pdoc.getElementById('mainArea').scrollTop : 0;
    const isLight = pdoc.body && pdoc.body.classList.contains('light');

    pdoc.open();
    pdoc.write(buildFullHtml());
    pdoc.close();

    if (isLight) pdoc.body.classList.add('light');
    if (pdoc.getElementById('mainArea')) pdoc.getElementById('mainArea').scrollTop = scrollTop;

    bindEvents();
  }

  function setStatus(msg) {
    const el = popupWindow.document.getElementById('saveStatus');
    if (!el) return;
    el.textContent = msg;
    setTimeout(() => { if (el.textContent === msg) el.textContent = ''; }, 4000);
  }

  function getSlots() {
    try { return JSON.parse(localStorage.getItem(SLOTS_KEY)) || []; } catch (e) { return []; }
  }
  function setSlots(arr) { localStorage.setItem(SLOTS_KEY, JSON.stringify(arr)); }

  function renderSlotsList() {
    const pdoc = popupWindow.document;
    const listEl = pdoc.getElementById('slotsList');
    const slots = getSlots();
    if (!slots.length) { listEl.innerHTML = '<div style="font-size:11px; color:#888;">저장된 슬롯이 없습니다.</div>'; return; }
    listEl.innerHTML = '';
    slots.slice().reverse().forEach(slot => {
      const row = pdoc.createElement('div');
      row.style.cssText = 'display:flex; gap:6px; align-items:center; background:var(--summary); padding:8px; border-radius:6px;';
      row.innerHTML = '<span style="flex:1; font-size:12px;">' + slot.label + '</span>' +
        '<button class="slotLoad" data-id="' + slot.id + '" style="padding:5px 8px; background:#3b82f6; color:white; border:none; border-radius:4px; cursor:pointer; font-size:11px;">불러오기</button>' +
        '<button class="slotDel" data-id="' + slot.id + '" style="padding:5px 8px; background:#ef4444; color:white; border:none; border-radius:4px; cursor:pointer; font-size:11px;">삭제</button>';
      listEl.appendChild(row);
    });
    listEl.querySelectorAll('.slotLoad').forEach(btn => btn.addEventListener('click', e => loadSlot(e.target.dataset.id)));
    listEl.querySelectorAll('.slotDel').forEach(btn => btn.addEventListener('click', e => {
      setSlots(getSlots().filter(s => String(s.id) !== e.target.dataset.id));
      renderSlotsList();
    }));
  }

  function loadSlot(id) {
    const slot = getSlots().find(s => String(s.id) === String(id));
    if (!slot) { setStatus('해당 슬롯을 찾을 수 없습니다.'); return; }
    Object.keys(DEFAULTS).forEach(v => {
      const val = slot.payload.currentStyles[v];
      if (val !== undefined) applyChange(v, val);
    });
    if (slot.payload.modeState) {
      Object.assign(modeState, slot.payload.modeState);
      applyModeToAllBlocks();
    }
    renderAll();
    setStatus('"' + slot.label + '" 슬롯을 불러왔습니다.');
  }

  function extractCssVars(text) {
    const rootIdx = text.indexOf(':root');
    if (rootIdx === -1) return {};
    const braceStart = text.indexOf('{', rootIdx);
    if (braceStart === -1) return {};
    let depth = 0, i = braceStart;
    for (; i < text.length; i++) {
      if (text[i] === '{') depth++;
      else if (text[i] === '}') { depth--; if (depth === 0) { i++; break; } }
    }
    const block = text.substring(braceStart, i);
    const map = {};
    const re = /(--[a-zA-Z0-9_-]+)\s*:\s*([^;]+);/g;
    let m;
    while ((m = re.exec(block)) !== null) {
      map[m[1].trim()] = m[2].trim().replace(/\s*!important\s*$/, '');
    }
    return map;
  }

  function createFinalExportText() {
    let text = '<style>\n  :root {\n';
    Object.keys(DEFAULTS).forEach(v => {
      text += '    ' + v + ': ' + currentStyles[v] + ';\n';
    });
    text += '  }\n</style>\n\n';
    text += '<!-- 탭 배치 모드는 CSS 가 아니라 각 .notion-tab-block 요소의 data 속성입니다.\n';
    text += '     아래 JS 를 페이지에 함께 넣어 모든 탭 블록에 이 배치 모드를 적용하세요. -->\n';
    text += '<script>\n';
    text += '  (function applyNotionTabModeConfig() {\n';
    const cfg = { default: modeState.default };
    if (modeState.mobile) cfg.mobile = modeState.mobile;
    if (modeState.overThreshold) cfg.overThreshold = modeState.overThreshold;
    text += '    const cfg = ' + JSON.stringify(cfg) + ';\n';
    text += '    document.querySelectorAll(".notion-tab-block").forEach(function(block) {\n';
    text += '      block.dataset.tabOverflowConfig = JSON.stringify(cfg);\n';
    text += '      block.dataset.tabOverflowThreshold = "' + modeState.threshold + '";\n';
    text += '      block.dataset.tabWheelScroll = "' + (modeState.wheelScroll ? '1' : '0') + '";\n';
    text += '      block.dataset.tabWheelSpeed = "' + modeState.wheelSpeed + '";\n';
    text += '      block.dataset.tabMoreLabel = "' + modeState.moreLabel.replace(/"/g, '\\"') + '";\n';
    text += '    });\n';
    text += '  })();\n';
    text += '</script>';
    return text;
  }

  function bindModeSection() {
    const pdoc = popupWindow.document;

    const defaultSel = pdoc.getElementById('modeDefault');
    const mobileSel = pdoc.getElementById('modeMobile');
    const overSel = pdoc.getElementById('modeOverThreshold');
    const thresholdRange = pdoc.getElementById('modeThreshold');
    const thresholdNum = pdoc.getElementById('modeThresholdNum');
    const wheelToggle = pdoc.getElementById('modeWheelScroll');
    const wheelSpeedRange = pdoc.getElementById('modeWheelSpeed');
    const wheelSpeedNum = pdoc.getElementById('modeWheelSpeedNum');
    const moreLabelInput = pdoc.getElementById('modeMoreLabel');
    if (!defaultSel) return;

    defaultSel.addEventListener('change', () => { modeState.default = defaultSel.value; applyModeToAllBlocks(); });
    mobileSel.addEventListener('change', () => { modeState.mobile = mobileSel.value; applyModeToAllBlocks(); });
    overSel.addEventListener('change', () => { modeState.overThreshold = overSel.value; applyModeToAllBlocks(); });

    thresholdRange.addEventListener('input', () => { thresholdNum.value = thresholdRange.value; modeState.threshold = Number(thresholdRange.value); applyModeToAllBlocks(); });
    thresholdNum.addEventListener('input', () => { thresholdRange.value = thresholdNum.value; modeState.threshold = Number(thresholdNum.value); applyModeToAllBlocks(); });

    wheelToggle.addEventListener('change', () => { modeState.wheelScroll = wheelToggle.checked; applyModeToAllBlocks(); });

    wheelSpeedRange.addEventListener('input', () => { wheelSpeedNum.value = wheelSpeedRange.value; modeState.wheelSpeed = Number(wheelSpeedRange.value); applyModeToAllBlocks(); });
    wheelSpeedNum.addEventListener('input', () => { wheelSpeedRange.value = wheelSpeedNum.value; modeState.wheelSpeed = Number(wheelSpeedNum.value); applyModeToAllBlocks(); });

    moreLabelInput.addEventListener('input', () => { modeState.moreLabel = moreLabelInput.value || '더보기'; applyModeToAllBlocks(); });
  }

  function bindEvents() {
    const pdoc = popupWindow.document;

    pdoc.getElementById('btnTheme').addEventListener('click', e => {
      const isLight = pdoc.body.classList.toggle('light');
      e.target.textContent = isLight ? '☀️ 라이트' : '🌙 다크';
    });

    bindModeSection();

    pdoc.getElementById('searchInput').addEventListener('input', e => {
      const term = e.target.value.trim().toLowerCase();
      pdoc.querySelectorAll('.panelSection').forEach(sec => {
        const groupMatch = (sec.getAttribute('data-groupname') || '').includes(term);
        let any = false;
        sec.querySelectorAll('[data-label]').forEach(item => {
          const match = groupMatch || (item.getAttribute('data-label') || '').includes(term);
          item.style.display = (term === '' || match) ? '' : 'none';
          if (term === '' || match) any = true;
        });
        sec.style.display = (term === '' || any || groupMatch) ? '' : 'none';
      });
    });

    GROUPS.forEach(g => g.items.forEach(item => {
      if (item.type === 'color') bindColor(item.var);
      if (item.type === 'border') bindBorder(item.var);
      if (item.type === 'padding') bindPadding(item.var);
      if (item.type === 'weightpair') bindWeightPair(item.sizeVar, item.weightVar);
      if (item.type === 'fontfamily') bindFontFamily(item.var);
      if (item.type === 'select') bindSelect(item.var);
      if (item.type === 'toggle') bindToggle(item);
      if (item.type === 'range') bindRange(item.var, item.unit);
      if (item.type === 'shadowtext' || item.type === 'text') bindText(item.var);
      if (item.type === 'transition') bindTransition(item.var);
    }));

    /* 초기 렌더 시 hover 세부 항목 노출 상태를 토글 값에 맞춰 동기화 */
    syncAllReveals();

    pdoc.querySelectorAll('.resetBtn').forEach(btn => {
      btn.addEventListener('click', () => {
        const v = btn.getAttribute('data-resetvar');
        if (!v || !DEFAULTS[v]) return;
        applyChange(v, DEFAULTS[v]);
        renderAll();
        setStatus(v + ' 을 기본값으로 되돌렸습니다.');
      });
    });

    pdoc.getElementById('btnGlobalReset').addEventListener('click', () => {
      if (!confirm('모든 디자인 설정(탭 배치 모드 포함)을 최초 상태로 초기화하시겠습니까?')) return;
      Object.keys(DEFAULTS).forEach(v => applyChange(v, DEFAULTS[v]));
      Object.assign(modeState, MODE_DEFAULTS);
      applyModeToAllBlocks();
      renderAll();
      setStatus('전체 설정을 초기화했습니다.');
    });

    pdoc.getElementById('btnSave').addEventListener('click', () => {
      const nowLabel = new Date().toLocaleString('ko-KR');
      const slots = getSlots();
      slots.push({ id: Date.now(), label: nowLabel + ' 저장', payload: { currentStyles: { ...currentStyles }, modeState: { ...modeState } } });
      setSlots(slots);
      renderSlotsList();
      setStatus('새 슬롯으로 저장했습니다 (' + nowLabel + ')');
    });
    pdoc.getElementById('btnSlots').addEventListener('click', () => {
      const panel = pdoc.getElementById('slotsPanel');
      const isOpen = panel.style.display !== 'none';
      panel.style.display = isOpen ? 'none' : 'block';
      pdoc.getElementById('importPanel').style.display = 'none';
      if (!isOpen) renderSlotsList();
    });

    pdoc.getElementById('btnInvalidate').addEventListener('click', () => {
      if (!confirm('현재 미리보기 값을 지우고 웹사이트의 기본 설정으로 되돌리시겠습니까? (저장된 슬롯은 유지됩니다)')) return;
      Object.keys(DEFAULTS).forEach(v => {
        document.documentElement.style.removeProperty(v);
        currentStyles[v] = DEFAULTS[v];
      });
      Object.assign(modeState, MODE_DEFAULTS);
      applyModeToAllBlocks();
      renderAll();
      setStatus('웹사이트 기본 설정으로 복원했습니다.');
    });

    const previewBtn = pdoc.getElementById('btnPreview');
    let savedBeforePreview = null;
    const startPreview = () => {
      savedBeforePreview = { ...currentStyles };
      Object.keys(DEFAULTS).forEach(v => document.documentElement.style.setProperty(v, DEFAULTS[v]));
    };
    const endPreview = () => {
      if (!savedBeforePreview) return;
      Object.keys(savedBeforePreview).forEach(v => document.documentElement.style.setProperty(v, savedBeforePreview[v]));
      savedBeforePreview = null;
    };
    previewBtn.addEventListener('mousedown', startPreview);
    previewBtn.addEventListener('mouseup', endPreview);
    previewBtn.addEventListener('mouseleave', endPreview);
    previewBtn.addEventListener('touchstart', e => { e.preventDefault(); startPreview(); });
    previewBtn.addEventListener('touchend', endPreview);

    pdoc.getElementById('btnImportToggle').addEventListener('click', () => {
      const panel = pdoc.getElementById('importPanel');
      const isOpen = panel.style.display !== 'none';
      panel.style.display = isOpen ? 'none' : 'block';
      pdoc.getElementById('slotsPanel').style.display = 'none';
    });
    pdoc.getElementById('btnImportApply').addEventListener('click', () => {
      const raw = pdoc.getElementById('importTextarea').value;
      if (!raw.trim()) { setStatus('붙여넣은 코드가 없습니다.'); return; }
      const map = extractCssVars(raw);
      if (!Object.keys(map).length) { setStatus('코드에서 인식 가능한 변수를 찾지 못했습니다.'); return; }
      Object.keys(map).forEach(v => { if (DEFAULTS[v] !== undefined) applyChange(v, map[v]); });
      renderAll();
      pdoc.getElementById('importPanel').style.display = 'none';
      setStatus('가져온 코드로 설정값을 채웠습니다.');
    });

    pdoc.getElementById('btnExportTrigger').addEventListener('click', () => {
      pdoc.getElementById('exportTextarea').value = createFinalExportText();
      const area = pdoc.getElementById('exportArea');
      area.style.display = area.style.display === 'none' ? 'block' : 'none';
      if (area.style.display === 'block') area.scrollIntoView({ behavior: 'smooth' });
    });
    pdoc.getElementById('btnCopy').addEventListener('click', () => {
      const ta = pdoc.getElementById('exportTextarea');
      ta.select();
      pdoc.execCommand('copy');
      alert('출력된 설정 코드가 복사되었습니다.');
    });
    pdoc.getElementById('btnCopyMin').addEventListener('click', () => {
      let raw = pdoc.getElementById('exportTextarea').value || createFinalExportText();
      let minified = raw.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\n/g, '').replace(/\s{2,}/g, ' ').trim();
      const temp = pdoc.createElement('textarea');
      temp.value = minified;
      pdoc.body.appendChild(temp);
      temp.select();
      pdoc.execCommand('copy');
      pdoc.body.removeChild(temp);
      alert('압축된 (Minify) 코드가 복사되었습니다.');
    });
  }

  /* ================= reveal(연동 노출) 처리 ================= */

  function findItemByVar(varName) {
    for (const g of GROUPS) {
      for (const it of g.items) {
        if (it.var === varName) return it;
      }
    }
    return null;
  }

  function setRevealVisibility(item, targetVars, show) {
    const pdoc = popupWindow.document;
    targetVars.forEach(targetVar => {
      const targetItem = findItemByVar(targetVar);
      if (!targetItem) return;
      const container = pdoc.querySelector('[data-label="' + targetItem.label.toLowerCase() + '"]');
      if (container) container.style.display = show ? '' : 'none';
    });
  }

  function syncAllReveals() {
    const pdoc = popupWindow.document;
    GROUPS.forEach(g => g.items.forEach(item => {
      if (item.type !== 'toggle' || !item.reveal) return;
      const el = pdoc.getElementById('tog_' + sanitize(item.var));
      if (!el) return;
      const show = item.revealWhen === false ? !el.checked : el.checked;
      setRevealVisibility(item, item.reveal, show);
    }));
  }

  /* ================= 개별 타입별 이벤트 바인딩 함수 ================= */

  function bindColor(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const hexEl = pdoc.getElementById('hex_' + id);
    const alphaEl = pdoc.getElementById('alpha_' + id);
    const labelEl = pdoc.getElementById('alphaLabel_' + id);
    const textEl = pdoc.getElementById('text_' + id);
    if (!hexEl) return;

    function sync(fromText) {
      if (fromText) {
        const typed = textEl.value.trim();
        const parsed = parseColorAny(typed);
        hexEl.value = parsed.hex;
        alphaEl.value = parsed.alphaPct;
        labelEl.textContent = parsed.alphaPct + '%';
        textEl.classList.remove('inputError');
        applyChange(varName, composeRgba(parsed.hex, parsed.alphaPct));
      } else {
        labelEl.textContent = alphaEl.value + '%';
        const rgba = composeRgba(hexEl.value, alphaEl.value);
        textEl.value = rgba;
        scheduleApplyChange(varName, rgba);
      }
    }
    hexEl.addEventListener('input', () => sync(false));
    alphaEl.addEventListener('input', () => sync(false));
    textEl.addEventListener('input', () => {
      const typed = textEl.value.trim();
      const looksValid = /^rgba?\(/.test(typed) || HEX_REGEX.test(typed);
      if (!looksValid) { textEl.classList.add('inputError'); return; }
      sync(true);
    });
  }

  function bindBorder(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const visEl = pdoc.getElementById('bvis_' + id);
    const detailEl = pdoc.getElementById('bdetail_' + id);
    const widthEl = pdoc.getElementById('bwidth_' + id);
    const widthNumEl = pdoc.getElementById('bwidthnum_' + id);
    const hexEl = pdoc.getElementById('bhex_' + id);
    const alphaEl = pdoc.getElementById('balpha_' + id);
    const alphaLabelEl = pdoc.getElementById('balphaLabel_' + id);
    const textEl = pdoc.getElementById('btext_' + id);
    if (!visEl) return;

    let prevAlpha = parseFloat(alphaEl.value) || 100;

    function compose(scheduled) {
      const width = parseFloat(widthEl.value) || 0;
      const alpha = visEl.checked ? (parseFloat(alphaEl.value) || 0) : 0;
      const value = composeBorderStr(width, hexEl.value, alpha);
      if (scheduled) scheduleApplyChange(varName, value);
      else applyChange(varName, value);
    }

    visEl.addEventListener('change', () => {
      detailEl.style.display = visEl.checked ? 'flex' : 'none';
      if (visEl.checked) {
        alphaEl.value = prevAlpha || 100;
        alphaLabelEl.textContent = alphaEl.value + '%';
      } else {
        prevAlpha = parseFloat(alphaEl.value) || prevAlpha;
      }
      compose(false);
    });
    widthEl.addEventListener('input', () => { widthNumEl.value = widthEl.value; compose(true); });
    widthNumEl.addEventListener('input', () => { widthEl.value = widthNumEl.value; compose(true); });
    hexEl.addEventListener('input', () => { textEl.value = composeRgba(hexEl.value, alphaEl.value); compose(true); });
    alphaEl.addEventListener('input', () => { alphaLabelEl.textContent = alphaEl.value + '%'; textEl.value = composeRgba(hexEl.value, alphaEl.value); compose(true); });
    textEl.addEventListener('input', () => {
      const typed = textEl.value.trim();
      if (!/^rgba?\(/.test(typed) && !HEX_REGEX.test(typed)) { textEl.classList.add('inputError'); return; }
      textEl.classList.remove('inputError');
      const parsed = parseColorAny(typed);
      hexEl.value = parsed.hex;
      alphaEl.value = parsed.alphaPct;
      alphaLabelEl.textContent = parsed.alphaPct + '%';
      compose(false);
    });
  }

  function bindPadding(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const visEl = pdoc.getElementById('pvis_' + id);
    const indEl = pdoc.getElementById('pind_' + id);
    const detailEl = pdoc.getElementById('pdetail_' + id);
    const tb2El = pdoc.getElementById('ptb2_' + id);
    const p4El = pdoc.getElementById('p4_' + id);
    const ptb = pdoc.getElementById('ptb_' + id), ptbNum = pdoc.getElementById('ptbnum_' + id);
    const plr = pdoc.getElementById('plr_' + id), plrNum = pdoc.getElementById('plrnum_' + id);
    const pt = pdoc.getElementById('pt_' + id), ptNum = pdoc.getElementById('ptnum_' + id);
    const pr = pdoc.getElementById('pr_' + id), prNum = pdoc.getElementById('prnum_' + id);
    const pb = pdoc.getElementById('pb_' + id), pbNum = pdoc.getElementById('pbnum_' + id);
    const pl = pdoc.getElementById('pl_' + id), plNum = pdoc.getElementById('plnum_' + id);
    if (!visEl) return;

    let prevVals = parsePaddingStr(currentStyles[varName]);

    function currentTRBL() {
      if (indEl.checked) {
        return { t: parseFloat(pt.value) || 0, r: parseFloat(pr.value) || 0, b: parseFloat(pb.value) || 0, l: parseFloat(pl.value) || 0 };
      }
      return { t: parseFloat(ptb.value) || 0, r: parseFloat(plr.value) || 0, b: parseFloat(ptb.value) || 0, l: parseFloat(plr.value) || 0 };
    }

    function compose(scheduled) {
      if (!visEl.checked) {
        if (scheduled) scheduleApplyChange(varName, '0px'); else applyChange(varName, '0px');
        return;
      }
      const v = currentTRBL();
      prevVals = v;
      const value = composePaddingStr(v.t, v.r, v.b, v.l);
      if (scheduled) scheduleApplyChange(varName, value); else applyChange(varName, value);
    }

    visEl.addEventListener('change', () => {
      detailEl.style.display = visEl.checked ? 'block' : 'none';
      if (visEl.checked) {
        ptb.value = ptbNum.value = prevVals.t;
        plr.value = plrNum.value = prevVals.r;
        pt.value = ptNum.value = prevVals.t;
        pr.value = prNum.value = prevVals.r;
        pb.value = pbNum.value = prevVals.b;
        pl.value = plNum.value = prevVals.l;
      }
      compose(false);
    });

    indEl.addEventListener('change', () => {
      if (indEl.checked) {
        const tbVal = parseFloat(ptb.value) || 0;
        const lrVal = parseFloat(plr.value) || 0;
        pt.value = ptNum.value = tbVal;
        pb.value = pbNum.value = tbVal;
        pr.value = prNum.value = lrVal;
        pl.value = plNum.value = lrVal;
        tb2El.style.display = 'none';
        p4El.style.display = 'flex';
      } else {
        const tVal = parseFloat(pt.value) || 0;
        const rVal = parseFloat(pr.value) || 0;
        ptb.value = ptbNum.value = tVal;
        plr.value = plrNum.value = rVal;
        tb2El.style.display = 'flex';
        p4El.style.display = 'none';
      }
      compose(false);
    });

    [[ptb, ptbNum], [plr, plrNum], [pt, ptNum], [pr, prNum], [pb, pbNum], [pl, plNum]].forEach(([rangeEl, numEl]) => {
      rangeEl.addEventListener('input', () => { numEl.value = rangeEl.value; compose(true); });
      numEl.addEventListener('input', () => { rangeEl.value = numEl.value; compose(true); });
    });
  }

  function bindWeightPair(sizeVar, weightVar) {
    const pdoc = popupWindow.document;
    const sizeId = sanitize(sizeVar);
    const weightId = sanitize(weightVar);
    const sizeRange = pdoc.getElementById('size_' + sizeId);
    const sizeNum = pdoc.getElementById('sizenum_' + sizeId);
    const weightRange = pdoc.getElementById('weight_' + weightId);
    const weightSel = pdoc.getElementById('weightsel_' + weightId);
    if (!sizeRange) return;

    sizeRange.addEventListener('input', () => { sizeNum.value = sizeRange.value; scheduleApplyChange(sizeVar, sizeRange.value + 'px'); });
    sizeNum.addEventListener('input', () => { sizeRange.value = sizeNum.value; scheduleApplyChange(sizeVar, sizeNum.value + 'px'); });
    weightRange.addEventListener('input', () => { weightSel.value = weightRange.value; scheduleApplyChange(weightVar, weightRange.value); });
    weightSel.addEventListener('change', () => { weightRange.value = weightSel.value; applyChange(weightVar, weightSel.value); });
  }

  function bindFontFamily(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const sel = pdoc.getElementById('fsel_' + id);
    const text = pdoc.getElementById('ftext_' + id);
    if (!sel) return;

    sel.addEventListener('change', () => {
      if (sel.value === 'custom') {
        text.style.display = 'block';
        applyChange(varName, text.value.trim() || 'inherit');
      } else {
        text.style.display = 'none';
        applyChange(varName, sel.value);
      }
    });
    text.addEventListener('input', () => applyChange(varName, text.value.trim() || 'inherit'));
  }

  function bindSelect(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const sel = pdoc.getElementById('sel_' + id);
    if (!sel) return;
    sel.addEventListener('change', () => applyChange(varName, sel.value));
  }

  function bindToggle(item) {
    const pdoc = popupWindow.document;
    const id = sanitize(item.var);
    const el = pdoc.getElementById('tog_' + id);
    if (!el) return;
    el.addEventListener('change', () => {
      const val = el.checked ? item.mapTrue : item.mapFalse;
      applyChange(item.var, val);
      if (item.reveal) {
        const show = item.revealWhen === false ? !el.checked : el.checked;
        setRevealVisibility(item, item.reveal, show);
      }
    });
  }

  function bindRange(varName, unit) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const range = pdoc.getElementById('r_' + id);
    const num = pdoc.getElementById('rn_' + id);
    if (!range) return;
    range.addEventListener('input', () => { num.value = range.value; scheduleApplyChange(varName, range.value + unit); });
    num.addEventListener('input', () => { range.value = num.value; scheduleApplyChange(varName, num.value + unit); });
  }

  function bindText(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const el = pdoc.getElementById('t_' + id);
    if (!el) return;
    el.addEventListener('input', () => applyChange(varName, el.value));
  }

  function bindTransition(varName) {
    const pdoc = popupWindow.document;
    const id = sanitize(varName);
    const durRange = pdoc.getElementById('trdur_' + id);
    const durNum = pdoc.getElementById('trdurnum_' + id);
    const easSel = pdoc.getElementById('treas_' + id);
    if (!durRange) return;

    function compose(scheduled) {
      const value = composeTransitionStr(parseFloat(durRange.value) || 0, easSel.value);
      if (scheduled) scheduleApplyChange(varName, value); else applyChange(varName, value);
    }

    durRange.addEventListener('input', () => { durNum.value = durRange.value; compose(true); });
    durNum.addEventListener('input', () => { durRange.value = durNum.value; compose(true); });
    easSel.addEventListener('change', () => compose(false));
  }

  /* ================= 초기 실행 ================= */

  renderAll();
}