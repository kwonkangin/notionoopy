        '</button></div>';
    }
    html += innerHtml + '</div>';
    return html;
  }

  function renderItem(item) {
    if (item.type === 'toggle') {
      return '<div class="itemBox" data-label="' + item.label.toLowerCase() + '">' + buildToggleControl(item) + '</div>';
    }
    if (item.type === 'weightpair') {
      const label = '<span class="itemTitle">' + item.label + '</span>' + varTag(item.sizeVar + ' / ' + item.weightVar);
      return '<div class="itemBox" data-label="' + item.label.toLowerCase() + '">' +
        buildItemWrapper(label, buildWeightPairControl(item.sizeVar, item.weightVar, item.min, item.max, item.unit), '') +
        '</div>';
    }

    const label = '<span class="itemTitle">' + item.label + '</span>' + varTag(item.var);
    let inner = '';
    if (item.type === 'color') inner = buildColorControl(item.var);
    else if (item.type === 'border') inner = buildBorderControl(item.var);
    else if (item.type === 'padding') inner = buildPaddingControl(item.var);
    else if (item.type === 'fontfamily') inner = buildFontFamilyControl(item.var);
    else if (item.type === 'select') inner = buildSelectControl(item.var, item.options);
    else if (item.type === 'range') inner = buildRangeControl(item.var, item.min, item.max, item.unit);
    else if (item.type === 'shadowtext' || item.type === 'text') inner = buildTextControl(item.var);
    else if (item.type === 'transition') inner = buildTransitionControl(item.var);

    return '<div data-label="' + item.label.toLowerCase() + '">' + buildItemWrapper(label, inner, item.var) + '</div>';
  }

  function renderSection(section) {
    let inner = '';
    section.items.forEach(item => { inner += renderItem(item); });
