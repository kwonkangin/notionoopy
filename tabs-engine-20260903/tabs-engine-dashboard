        delete pendingUpdates[v];
      });
      pendingFrame = null;
    });
  }

  /* ================= HTML 빌더 ================= */

  function sanitize(v) { return v.replace(/[^a-zA-Z0-9]/g, '_'); }
  function varTag(v) { return '<div class="vtag">' + v + '</div>'; }

  function buildModeSectionHtml() {
