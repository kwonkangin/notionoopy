      '<div class="toggleTextCol"><span class="toggleTitle">휠 스크롤 사용</span>' + varTag('data-tab-wheel-scroll') + '<span class="tip">scroll / more-dropdown 모드에서 마우스 휠로 탭 목록을 좌우 이동</span></div>' +
      '</div>';

    inner += '<div class="itemBox" data-label="탭 배치 모드 휠 감도">' +
      '<div class="itemHead"><span class="itemTitle">휠 스크롤 감도</span>' + varTag('data-tab-wheel-speed') + '</div>' +
      '<div class="rowFlex"><input type="range" class="rangeInput" id="modeWheelSpeed" min="0.1" max="5" step="0.1" value="' + modeState.wheelSpeed + '"><input type="number" class="numInput" id="modeWheelSpeedNum" step="0.1" value="' + modeState.wheelSpeed + '"></div>' +
      '</div>';

    inner += '<div class="itemBox" data-label="탭 배치 모드 더보기 문구">' +
      '<div class="itemHead"><span class="itemTitle">더보기 버튼 문구</span>' + varTag('data-tab-more-label') + '</div>' +
