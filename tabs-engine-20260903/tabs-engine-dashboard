  function buildColorControl(varName) {
    const c = parseColorAny(currentStyles[varName]);
    const id = sanitize(varName);
    return '<div class="colorRow">' +
      '<input type="color" class="colorChip" id="hex_' + id + '" value="' + c.hex + '">' +
      '<input type="range" class="rangeInput" id="alpha_' + id + '" min="0" max="100" value="' + c.alphaPct + '">' +
      '<span class="alphaLabel" id="alphaLabel_' + id + '">' + c.alphaPct + '%</span>' +
      '<input type="text" class="colorText mono" id="text_' + id + '" value="' + composeRgba(c.hex, c.alphaPct) + '">' +
      '</div>';
  }

  function buildBorderControl(varName) {
    const b = parseBorderStr(currentStyles[varName]);
    const id = sanitize(varName);
    const visible = b.alphaPct > 0;
    return '<div class="borderGroup">' +
      '<label class="toggleWrap"><input type="checkbox" id="bvis_' + id + '" ' + (visible ? 'checked' : '') + '><span class="toggleSlider"></span></label>' +
      '<span class="toggleCaption">테두리 노출</span>' +
      '<div class="borderDetail" id="bdetail_' + id + '" style="display:' + (visible ? 'flex' : 'none') + ';">' +
      '<div class="rowFlex"><span class="miniLabel">굵기</span><input type="range" class="rangeInput" id="bwidth_' + id + '" min="0" max="20" value="' + b.width + '"><input type="number" class="numInput" id="bwidthnum_' + id + '" value="' + b.width + '"></div>' +
      '<div class="colorRow"><span class="miniLabel">색상</span><input type="color" class="colorChip" id="bhex_' + id + '" value="' + b.hex + '"><input type="range" class="rangeInput" id="balpha_' + id + '" min="0" max="100" value="' + b.alphaPct + '"><span class="alphaLabel" id="balphaLabel_' + id + '">' + b.alphaPct + '%</span><input type="text" class="colorText mono" id="btext_' + id + '" value="' + composeRgba(b.hex, b.alphaPct) + '"></div>' +
      '</div></div>';
  }

  function buildPaddingControl(varName) {
    const p = parsePaddingStr(currentStyles[varName]);
    const id = sanitize(varName);
    const visible = !(p.t === 0 && p.r === 0 && p.b === 0 && p.l === 0);
    const individual = !(p.t === p.b && p.r === p.l);
    return '<div class="paddingGroup">' +
      '<div class="rowFlex" style="margin-bottom:8px;">' +
      '<label class="toggleWrap"><input type="checkbox" id="pvis_' + id + '" ' + (visible ? 'checked' : '') + '><span class="toggleSlider"></span></label>' +
      '<span class="toggleCaption">여백 노출</span>' +
      '<label class="toggleWrap" style="margin-left:auto;"><input type="checkbox" id="pind_' + id + '" ' + (individual ? 'checked' : '') + '><span class="toggleSlider"></span></label>' +
      '<span class="toggleCaption">개별조정 (4방향)</span>' +
      '</div>' +
      '<div class="padDetail" id="pdetail_' + id + '" style="display:' + (visible ? 'block' : 'none') + ';">' +
      '<div class="rowFlex2" id="ptb2_' + id + '" style="display:' + (individual ? 'none' : 'flex') + ';">' +
      '<div class="halfCol"><span class="miniLabel">상하</span><input type="range" class="rangeInput" id="ptb_' + id + '" min="0" max="100" value="' + p.t + '"><input type="number" class="numInput" id="ptbnum_' + id + '" value="' + p.t + '"></div>' +
      '<div class="halfCol"><span class="miniLabel">좌우</span><input type="range" class="rangeInput" id="plr_' + id + '" min="0" max="100" value="' + p.r + '"><input type="number" class="numInput" id="plrnum_' + id + '" value="' + p.r + '"></div>' +
      '</div>' +
      '<div class="rowFlex4" id="p4_' + id + '" style="display:' + (individual ? 'flex' : 'none') + ';">' +
      '<div class="quartCol"><span class="miniLabel">위</span><input type="range" class="rangeInput" id="pt_' + id + '" min="0" max="100" value="' + p.t + '"><input type="number" class="numInput" id="ptnum_' + id + '" value="' + p.t + '"></div>' +
      '<div class="quartCol"><span class="miniLabel">오른쪽</span><input type="range" class="rangeInput" id="pr_' + id + '" min="0" max="100" value="' + p.r + '"><input type="number" class="numInput" id="prnum_' + id + '" value="' + p.r + '"></div>' +
      '<div class="quartCol"><span class="miniLabel">아래</span><input type="range" class="rangeInput" id="pb_' + id + '" min="0" max="100" value="' + p.b + '"><input type="number" class="numInput" id="pbnum_' + id + '" value="' + p.b + '"></div>' +
      '<div class="quartCol"><span class="miniLabel">왼쪽</span><input type="range" class="rangeInput" id="pl_' + id + '" min="0" max="100" value="' + p.l + '"><input type="number" class="numInput" id="plnum_' + id + '" value="' + p.l + '"></div>' +
      '</div></div></div>';
