  function buildWeightPairControl(sizeVar, weightVar, min, max, unit) {
    const sizeId = sanitize(sizeVar);
    const weightId = sanitize(weightVar);
    const sizeVal = parseFloat(currentStyles[sizeVar]) || min;
    const weightVal = parseInt(currentStyles[weightVar], 10) || 400;
    let weightOptions = '';
    [100, 200, 300, 400, 500, 600, 700, 800, 900].forEach(w => {
      weightOptions += '<option value="' + w + '" ' + (w === weightVal ? 'selected' : '') + '>' + w + '</option>';
    });
    return '<div class="rowFlex2">' +
      '<div class="halfCol"><span class="miniLabel">글자 크기</span><input type="range" class="rangeInput" id="size_' + sizeId + '" min="' + min + '" max="' + max + '" value="' + sizeVal + '"><input type="number" class="numInput" id="sizenum_' + sizeId + '" value="' + sizeVal + '"></div>' +
      '<div class="halfCol"><span class="miniLabel">글자 굵기</span><input type="range" class="rangeInput" id="weight_' + weightId + '" min="100" max="900" step="100" value="' + weightVal + '"><select class="basicSel" id="weightsel_' + weightId + '">' + weightOptions + '</select></div>' +
      '</div>';
  }

  function buildFontFamilyControl(varName) {
    const id = sanitize(varName);
    const rawVal = currentStyles[varName] || 'inherit';
    const isCustom = FONT_FAMILY_KNOWN.indexOf(rawVal) === -1;
    let opts = '';
    FONT_FAMILY_OPTIONS.forEach(([val, label]) => {
      const sel = (val === 'custom') ? isCustom : (!isCustom && val === rawVal);
      opts += '<option value="' + val + '" ' + (sel ? 'selected' : '') + '>' + label + '</option>';
    });
    return '<select class="basicSel" id="fsel_' + id + '">' + opts + '</select>' +
      '<input type="text" class="textInput mono" id="ftext_' + id + '" value="' + (isCustom ? rawVal : '') + '" placeholder="예: MyCustomFont" style="display:' + (isCustom ? 'block' : 'none') + '; margin-top:6px;">';
  }

  function buildSelectControl(varName, options) {
    const id = sanitize(varName);
    let opts = '';
    options.forEach(([val, label]) => {
      opts += '<option value="' + val + '" ' + (val === currentStyles[varName] ? 'selected' : '') + '>' + label + '</option>';
    });
    return '<select class="basicSel" id="sel_' + id + '">' + opts + '</select>';
  }

  function buildToggleControl(item) {
    const id = sanitize(item.var);
    const isOn = currentStyles[item.var] === item.mapTrue;
    return '<div class="toggleRow">' +
      '<label class="toggleWrap"><input type="checkbox" id="tog_' + id + '" ' + (isOn ? 'checked' : '') + '><span class="toggleSlider"></span></label>' +
      '<div class="toggleTextCol"><span class="toggleTitle">' + item.label + '</span>' + varTag(item.var) + (item.tip ? '<span class="tip">' + item.tip + '</span>' : '') + '</div>' +
      '</div>';
  }

  function buildRangeControl(varName, min, max, unit) {
    const id = sanitize(varName);
    const val = parseFloat(currentStyles[varName]) || 0;
    return '<div class="rowFlex">' +
      '<input type="range" class="rangeInput" id="r_' + id + '" min="' + min + '" max="' + max + '" value="' + val + '">' +
      '<input type="number" class="numInput" id="rn_' + id + '" value="' + val + '">' +
      '</div>';
  }

  function buildTextControl(varName) {
    const id = sanitize(varName);
    return '<input type="text" class="textInput mono" id="t_' + id + '" value="' + currentStyles[varName] + '">';
  }

  function buildTransitionControl(varName) {
    const t = parseTransitionStr(currentStyles[varName]);
    const id = sanitize(varName);
    let easingOpts = '';
    EASING_OPTIONS.forEach(([val, label]) => {
      easingOpts += '<option value="' + val + '" ' + (val === t.easing ? 'selected' : '') + '>' + label + '</option>';
