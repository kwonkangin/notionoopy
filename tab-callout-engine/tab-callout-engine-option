/*
<!-- 갤러리 탭-콜아웃 매칭 디자인 -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/kwonkangin/notionoopy@main/tab-callout-engine/tab-callout-engine.css">
<script src="https://cdn.jsdelivr.net/gh/kwonkangin/notionoopy@main/tab-callout-engine/tab-callout-engine.js" defer></script>
*/


<style>
  /* 맞춤형 스타일 최상위 변수 설정 구역 */
  :root {
    --customTabBg_z9x: transparent;
    --customTabColor_p2m: rgba(120, 119, 116, 1);
    --customTabActiveBg_w4a: rgba(241, 241, 239, 1);
    --customTabActiveColor_k8b: rgba(55, 53, 47, 1);
    --customTabFontSize_n1c: 14px;
    --customTabFontWeight_y7t: 400;
    --customTabActiveWeight_d3f: 600;
    --customTabPadding_r5q: 6px 12px;
    --customTabRadius_m9h: 6px;
    --customTabGap_b2v: 8px;
    --customTabIconDisplay_j4k: inline-block; 
    
    --calloutMarginTop_v5x: 10px;
    --calloutMarginBottom_w6y: 16px;

    --borderToggle_a1z: true;
    --borderConfig_a1z: 2px solid rgba(55, 53, 47, 1);
    
    --shadowToggle_u8f: true;
    --shadowConfig_u8f: 0px -1px 0px 0px rgba(233, 233, 231, 1) inset;
    
    /* 마우스 올림 상태 및 팽창 애니메이션 제어 변수 */
    --hoverTransitionSpeed_t9x: 0.2s;
    --hoverTransformScale_s2w: 1.05;
    --hoverBgColor_m4b: rgba(241, 241, 239, 0.5);
    --hoverTextColor_z1n: rgba(55, 53, 47, 1);
    --hoverRadius_k9v: 6px;
    --slideAnimSpeed_p4q: 0.4s;
    
    /* 텍스트 글자 수 제한 제어 변수 */
    --textLimitToggle_b4v: false;
    --textLimitLength_c5x: 10;
  }
</style>
<script>
  /* 갤러리 '이름(제목)' 기반 레이아웃 제어 설정 객체 */
  window.efc_galleryConfig_v2 = {
    default: "scroll",
    exceptions: {
      "갤러리뷰 템플릿": "wrap",
      "특정 데이터베이스 이름": "more"
    }
  };
</script>


<style>
  /* 
    ====================================================================
    [맞춤형 스타일 최상위 변수 설정 구역]
    아래 변수들의 값만 수정하면 전체 탭과 콜아웃의 디자인이 실시간으로 변경됩니다.
    ====================================================================
  */
  :root {
    
    /* -------------------------------------------
       1. 탭 기본 서식 및 텍스트 제어
       ------------------------------------------- */

    /* 
      [기본 탭 배경색] 
      - 목적: 선택되지 않은 일반 탭의 바탕 색상을 결정합니다.
      - 기본값: transparent (투명)
      - 설정 옵션: transparent, HEX(#ffffff), RGBA(rgba(255,255,255,1)) 등
    */
    --customTabBg_z9x: transparent;

    /* 
      [기본 탭 글자색] 
      - 목적: 선택되지 않은 일반 탭의 글자 색상을 결정합니다.
      - 기본값: rgba(120, 119, 116, 1) (노션 기본 회색)
      - 설정 옵션: HEX 색상 코드, RGBA 등
    */
    --customTabColor_p2m: rgba(120, 119, 116, 1);

    /* 
      [글자 크기] 
      - 목적: 탭 내부 텍스트의 크기를 조절합니다.
      - 기본값: 14px
      - 설정 옵션: 10px ~ 30px 범위 내 권장
    */
    --customTabFontSize_n1c: 14px;

    /* 
      [기본 탭 글자 굵기] 
      - 목적: 선택되지 않은 일반 탭의 글자 굵기를 조절합니다.
      - 기본값: 400 (일반 굵기)
      - 설정 옵션: 100(가장 얇음) ~ 900(가장 굵음) 사이의 백 단위 숫자
    */
    --customTabFontWeight_y7t: 400;

    /* -------------------------------------------
       2. 탭 선택(활성화) 상태 서식
       ------------------------------------------- */

    /* 
      [활성 탭 배경색] 
      - 목적: 현재 클릭되어 활성화된 탭의 바탕 색상을 결정합니다.
      - 기본값: rgba(241, 241, 239, 1) (노션 기본 연한 회색 둥근 배경)
      - 설정 옵션: HEX 색상 코드, RGBA 등
    */
    --customTabActiveBg_w4a: rgba(241, 241, 239, 1);

    /* 
      [활성 탭 글자색] 
      - 목적: 현재 클릭되어 활성화된 탭의 글자 색상을 결정합니다.
      - 기본값: rgba(55, 53, 47, 1) (노션 기본 짙은 검정색)
      - 설정 옵션: HEX 색상 코드, RGBA 등
    */
    --customTabActiveColor_k8b: rgba(55, 53, 47, 1);

    /* 
      [활성 탭 글자 굵기] 
      - 목적: 현재 클릭되어 활성화된 탭의 글자 굵기를 조절합니다.
      - 기본값: 600 (약간 굵게)
      - 설정 옵션: 100(가장 얇음) ~ 900(가장 굵음) 사이의 백 단위 숫자
    */
    --customTabActiveWeight_d3f: 600;

    /* -------------------------------------------
       3. 탭 넓이/높이, 간격, 둥글기 제어
       ------------------------------------------- */

    /* 
      [탭 내부 여백 (높이/넓이)] 
      - 목적: 탭 버튼 안쪽의 상하(높이) 및 좌우(넓이) 공간을 결정합니다.
      - 기본값: 6px 12px (위아래 6px, 좌우 12px)
      - 설정 옵션: "위아래수치px 좌우수치px" 형태로 입력 (예: 10px 20px)
    */
    --customTabPadding_r5q: 6px 12px;

    /* 
      [모서리 둥글기] 
      - 목적: 탭 버튼 외곽선의 둥근 정도(곡률)를 조절합니다.
      - 기본값: 6px (살짝 둥근 사각형)
      - 설정 옵션: 0px(완전한 직각) ~ 30px(완전한 타원형)
    */
    --customTabRadius_m9h: 6px;

    /* 
      [탭 사이 간격] 
      - 목적: 탭 버튼과 다음 탭 버튼 사이의 물리적인 거리를 조절합니다.
      - 기본값: 8px
      - 설정 옵션: 0px ~ 50px 사이 픽셀값 입력
    */
    --customTabGap_b2v: 8px;

    /* 
      [탭 아이콘 표시 여부] 
      - 목적: 노션 페이지나 텍스트 앞에 붙은 이모지/아이콘의 노출 여부를 결정합니다.
      - 기본값: inline-block (아이콘 표시함)
      - 설정 옵션: inline-block (표시) / none (숨김)
    */
    --customTabIconDisplay_j4k: inline-block; 

    /* -------------------------------------------
       4. 콜아웃 상하 여백 및 애니메이션 제어
       ------------------------------------------- */

    /* 
      [콜아웃 상단 여백] 
      - 목적: 탭 메뉴(버튼들)와 콜아웃 상자 윗부분 사이의 거리를 결정합니다.
      - 기본값: 10px
      - 설정 옵션: 0px ~ 100px 사이 픽셀값 입력
    */
    --calloutMarginTop_v5x: 10px;

    /* 
      [콜아웃 하단 여백] 
      - 목적: 콜아웃 상자 아랫부분과 갤러리(사진들) 사이의 거리를 결정합니다.
      - 기본값: 16px
      - 설정 옵션: 0px ~ 100px 사이 픽셀값 입력
    */
    --calloutMarginBottom_w6y: 16px;

    /* 
      [콜아웃 팽창 애니메이션 속도] 
      - 목적: 콜아웃이 나타날 때 아래 갤러리 카드를 밀어내며 팽창하는 속도를 결정합니다.
      - 기본값: 0.4s (0.4초)
      - 설정 옵션: 0.1s(매우 빠름) ~ 2.0s(매우 느림)
    */
    --slideAnimSpeed_p4q: 0.4s;

    /* -------------------------------------------
       5. 탭 하단 선 및 컨테이너 그림자 제어
       ------------------------------------------- */

    /* 
      [활성 탭 하단 선 노출 여부] 
      - 목적: 우피에서 활성화된 탭 밑에 그어지는 얇은 밑줄을 쓸지 말지 결정합니다.
      - 기본값: true (사용함)
      - 설정 옵션: true (표시) / false (숨김)
    */
    --borderToggle_a1z: true;

    /* 
      [활성 탭 하단 선 스타일 구성] 
      - 목적: 하단 선을 사용할 경우 두께와 선의 종류, 색상을 종합적으로 지정합니다.
      - 기본값: 2px solid rgba(55, 53, 47, 1) (2픽셀 실선 검정색)
      - 설정 옵션: "두께px solid 색상값" 형태로 작성 / 숨길 경우 none 입력
    */
    --borderConfig_a1z: 2px solid rgba(55, 53, 47, 1);
    
    /* 
      [탭 컨테이너 하단 그림자 노출 여부] 
      - 목적: 탭 메뉴를 감싸는 전체 영역 바닥에 그림자를 줄지 말지 결정합니다.
      - 기본값: true (사용함)
      - 설정 옵션: true (표시) / false (숨김)
    */
    --shadowToggle_u8f: true;

    /* 
      [탭 컨테이너 하단 그림자 스타일 구성] 
      - 목적: 그림자를 사용할 경우 X축/Y축/흐림/퍼짐/색상을 종합적으로 지정합니다.
      - 기본값: 0px -1px 0px 0px rgba(233, 233, 231, 1) inset (우피 기본 연한 회색 구분선)
      - 설정 옵션: "X Y 흐림 퍼짐 색상 inset" 형태로 작성 / 숨길 경우 none 입력
    */
    --shadowConfig_u8f: 0px -1px 0px 0px rgba(233, 233, 231, 1) inset;
    
    /* -------------------------------------------
       6. 마우스 올림(Hover) 상태 시각 효과 제어
       ------------------------------------------- */

    /* 
      [호버 전환 속도] 
      - 목적: 마우스를 올렸을 때 색상과 크기가 변하는 속도를 결정합니다.
      - 기본값: 0.2s (0.2초)
      - 설정 옵션: 0.0s(즉시 변함) ~ 2.0s(매우 천천히 변함)
    */
    --hoverTransitionSpeed_t9x: 0.2s;

    /* 
      [호버 확대 비율] 
      - 목적: 마우스를 올렸을 때 탭 버튼이 커지는 비율을 결정합니다.
      - 기본값: 1.05 (원래 크기보다 5% 확대)
      - 설정 옵션: 1.0(변화 없음) / 1.1(10% 확대) / 1.2(20% 확대)
    */
    --hoverTransformScale_s2w: 1.05;

    /* 
      [호버 배경 색상] 
      - 목적: 마우스를 올렸을 때 탭의 바탕 색상을 결정합니다.
      - 기본값: rgba(241, 241, 239, 0.5) (연한 회색 반투명)
      - 설정 옵션: HEX 색상 코드, RGBA 등
    */
    --hoverBgColor_m4b: rgba(241, 241, 239, 0.5);

    /* 
      [호버 글자 색상] 
      - 목적: 마우스를 올렸을 때 탭의 글자 색상을 결정합니다.
      - 기본값: rgba(55, 53, 47, 1) (검정색)
      - 설정 옵션: HEX 색상 코드, RGBA 등
    */
    --hoverTextColor_z1n: rgba(55, 53, 47, 1);

    /* 
      [호버 둥글기] 
      - 목적: 마우스를 올렸을 때 탭의 모서리 곡률을 다르게 줄지 결정합니다.
      - 기본값: 6px (기본 둥글기와 동일하게 유지)
      - 설정 옵션: 0px ~ 30px 
    */
    --hoverRadius_k9v: 6px;
    
    /* -------------------------------------------
       7. 텍스트 글자 수 제한 설정
       ------------------------------------------- */

    /* 
      [글자 수 제한 활성화] 
      - 목적: 탭 이름이 너무 길어지는 것을 방지하기 위해 강제로 자를지 결정합니다.
      - 기본값: false (사용 안 함 - 글자 전체 노출)
      - 설정 옵션: true (글자 자르기 켜기) / false (글자 자르기 끄기)
    */
    --textLimitToggle_b4v: false;

    /* 
      [최대 허용 글자 수] 
      - 목적: 글자 수 제한이 켜져 있을 때, 몇 글자까지만 보여주고 '...'으로 자를지 결정합니다.
      - 기본값: 10 (10글자까지만 표시)
      - 설정 옵션: 2 ~ 30 사이의 숫자 입력
    */
    --textLimitLength_c5x: 10;
  }
</style>

<script>
  /* 
    ====================================================================
    [갤러리 이름(데이터베이스 제목) 기반 배열 방식 제어 객체]
    우피에 노출되는 갤러리의 정렬 방식(스크롤, 줄바꿈, 더보기)을 결정합니다.
    ====================================================================
  */
  window.efc_galleryConfig_v2 = {
    
    /* 
      [기본 배열 방식]
      - 목적: 아래 예외(exceptions) 목록에 등록되지 않은 모든 갤러리의 기본 배열 방식을 결정합니다.
      - 기본값: "scroll"
      - 설정 옵션: 
        1) "scroll" : 가로로 길게 나열되어 마우스/터치로 스크롤하며 넘겨보는 방식
        2) "wrap" : 화면 너비에 맞춰 아래로 자연스럽게 줄바꿈되는 방식
        3) "more" : 끝에 '>' 더보기 화살표 단추를 생성하여 넘겨보는 방식
    */
    default: "scroll",

    /* 
      [예외 갤러리 설정]
      - 목적: 우피 화면에 표출된 특정 이름(데이터베이스 제목)을 가진 갤러리만 예외적으로 다른 배열 방식을 강제 지정할 때 사용합니다.
      - 기본값: 비어있음 (아래 예시 형태 참고)
      - 작성 규칙: "정확한 갤러리 제목": "배열방식(scroll/wrap/more)" 형태로 작성하며, 여러 개일 경우 끝에 쉼표(,)를 넣어 계속 추가할 수 있습니다.
    */
    exceptions: {
      "갤러리뷰 템플릿": "wrap",            // '갤러리뷰 템플릿'이라는 이름을 가진 갤러리는 무조건 아래로 줄바꿈 시킵니다.
      "특정 데이터베이스 이름": "more"        // '특정 데이터베이스 이름'을 가진 갤러리는 끝에 더보기(>) 단추를 생성합니다.
    }
  };
</script>