  --shadowY_c3d: -1px;                                   /* [그림자 세로 오프셋] 목적: 그림자를 위아래로 밀어내는 값 | 기본값: -1px | 옵션: -20~20px */
  --shadowBlur_d4e: 0px;                                 /* [그림자 흐림 정도] 목적: 그림자 경계를 얼마나 부드럽게 퍼트릴지 | 기본값: 0px | 옵션: 0~30px */
  --shadowSpread_e5f: 0px;                               /* [그림자 퍼짐 정도] 목적: 그림자 크기 자체를 확대/축소 | 기본값: 0px | 옵션: -10~20px */
  --shadowColor_f6g: rgba(233, 233, 231, 1);             /* [그림자 색상] 목적: 그림자의 색과 투명도 | 기본값: rgba(233,233,231,1) | 옵션: HEX, RGBA */
  --customTabPadding_r5q: 5px 10px;                      /* [탭 내부 여백] 목적: 탭 내부 상하/좌우 패딩("상하 좌우" 형식) | 기본값: 6px 12px | 옵션: "Npx Mpx" 형식 */
  --borderConfig_a1z: none;                              /* [실제 적용되는 하단선 값] 목적: borderToggle_a1z + activeBorderSize_y2b + activeBorderColor_z3c 3개를 합쳐 대시보드가 자동 생성하는 최종 CSS border-bottom 값 | 기본값: none | 옵션: "Npx solid 색상" 또는 none (직접 수정 비권장, 위 3개 재료값을 바꾸는 것을 권장) */
  --shadowConfig_u8f: none;                              /* [실제 적용되는 그림자 값] 목적: shadowToggle_u8f + X/Y/Blur/Spread/Color 5개를 합쳐 대시보드가 자동 생성하는 최종 CSS box-shadow 값 | 기본값: none | 옵션: "X Y Blur Spread 색상 inset" 또는 none (직접 수정 비권장) */
  --customTabIconDisplay_j4k: inline-block;              /* [탭 아이콘 표시 여부] 목적: 탭 안의 노션 아이콘(SVG) 노출 여부 | 기본값: inline-block(표시) | 옵션: inline-block(표시) / none(숨김) */
}
