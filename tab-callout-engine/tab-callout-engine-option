<style>
:root {
  --customTabBg_z9x: rgba(221, 255, 0, 1.00);            /* [기본 탭 배경색] 목적: 선택 안 된 일반 탭의 바탕색 | 기본값: transparent | 옵션: transparent, HEX, RGBA */
  --customTabColor_p2m: rgba(255, 0, 0, 1.00);           /* [기본 탭 글자색] 목적: 선택 안 된 일반 탭의 글자색 | 기본값: rgba(120,119,116,1) | 옵션: HEX, RGBA */
  --customTabFontSize_n1c: 17px;                         /* [기본 글자 크기] 목적: 모든 탭 글자 크기(활성/비활성 공통) | 기본값: 14px | 옵션: 10~30px */
  --customTabFontWeight_y7t: 400;                        /* [기본 글자 굵기] 목적: 선택 안 된 일반 탭 글자 굵기 | 기본값: 400 | 옵션: 100~900 (100 단위) */
  --textLimitToggle_b4v: false;                          /* [글자수 제한 활성화] 목적: 탭 이름이 길 때 말줄임표(...) 처리 여부 | 기본값: false | 옵션: true / false */
  --textLimitLength_c5x: 6;                              /* [최대 허용 글자수] 목적: textLimitToggle_b4v가 true일 때 자를 글자 수 | 기본값: 10 | 옵션: 2~30 (정수) */
  --customTabActiveBg_w4a: rgba(255, 0, 0, 1.00);        /* [선택된 탭 배경색] 목적: 현재 활성화된 탭의 바탕색 | 기본값: rgba(241,241,239,1) | 옵션: HEX, RGBA */
  --customTabActiveColor_k8b: rgba(0, 47, 255, 1.00);    /* [선택된 탭 글자색] 목적: 현재 활성화된 탭의 글자색 | 기본값: rgba(55,53,47,1) | 옵션: HEX, RGBA */
  --customTabActiveWeight_d3f: 800;                      /* [선택된 탭 글자 굵기] 목적: 활성 탭 글자 굵기 | 기본값: 600 | 옵션: 100~900 (100 단위) */
  --slideAnimSpeed_p4q: 0.8s;                            /* [콜아웃 팽창 속도] 목적: 탭 클릭 시 콜아웃이 밀어내며 펼쳐지는 애니메이션 속도 | 기본값: 0.4s | 옵션: 0.1~2.0s */
  --hoverTransitionSpeed_t9x: 0.2s;                      /* [호버 색상 전환 속도] 목적: 마우스 올릴 때 색이 바뀌는 전환 속도 | 기본값: 0.2s | 옵션: 0.0~2.0s */
  --hoverTransformScale_s2w: 1;                          /* [호버 확대 비율] 목적: 마우스 올릴 때 탭이 커지는 비율 | 기본값: 1.05 | 옵션: 1.0~1.5 */
  --hoverBgColor_m4b: rgba(34, 0, 255, 1.00);            /* [호버 배경색] 목적: 마우스 올렸을 때 탭 배경색 | 기본값: rgba(241,241,239,0.5) | 옵션: HEX, RGBA */
  --hoverTextColor_z1n: rgba(0, 255, 195, 1.00);         /* [호버 글자색] 목적: 마우스 올렸을 때 탭 글자색 | 기본값: rgba(55,53,47,1) | 옵션: HEX, RGBA */
  --hoverRadius_k9v: 30px;                               /* [호버 모서리 둥글기] 목적: 마우스 올렸을 때 탭 모서리 곡률 | 기본값: 6px | 옵션: 0~30px */
  --customTabGap_b2v: 12px;                              /* [탭 사이 간격] 목적: 탭과 탭 사이의 좌우 간격 | 기본값: 8px | 옵션: 0~50px */
  --customTabRadius_m9h: 30px;                           /* [기본 모서리 둥글기] 목적: 탭(비활성 포함) 모서리 곡률 | 기본값: 6px | 옵션: 0~30px */
  --calloutMarginTop_v5x: 26px;                          /* [콜아웃 상단 여백] 목적: 펼쳐진 콜아웃 위쪽 여백 | 기본값: 10px | 옵션: 0~100px */
  --calloutMarginBottom_w6y: 78px;                       /* [콜아웃 하단 여백] 목적: 펼쳐진 콜아웃 아래쪽 여백 | 기본값: 16px | 옵션: 0~100px */
  --borderToggle_a1z: false;                             /* [활성 탭 하단선 노출 토글] 목적: 아래 --borderConfig_a1z를 만드는 재료값(참고용) | 기본값: true | 옵션: true / false */
  --activeBorderSize_y2b: 2px;                           /* [활성 탭 하단선 두께] 목적: borderToggle_a1z가 true일 때 선 두께 | 기본값: 2px | 옵션: 1~10px */
