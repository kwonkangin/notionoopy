     ================================================================ */

  function findRoots() {
    const tablists = Array.from(document.querySelectorAll('[role="tablist"]'));
    const roots = new Set();
    tablists.forEach(tablist => {
      const root = tablist.closest('.notion-collection_view-block');
      if (root) roots.add(root);
