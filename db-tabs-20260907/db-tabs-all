        display: 'inline-flex',
        'align-items': 'center',
        gap: '6px',
        padding: `${cssVar('tabPadY', '6px')} ${cssVar('tabPadX', '10px')}`,
        background: active ? cssVar('activeTabBg', 'rgba(55,53,47,0.06)') : cssVar('tabBg', 'transparent'),
        color: active ? cssVar('activeTabTextColor', 'inherit') : cssVar('tabTextColor', 'inherit'),
        'font-size': active ? cssVar('activeTabFontSize', '14px') : cssVar('tabFontSize', '14px'),
        'font-weight': active ? cssVar('activeTabFontWeight', '500') : cssVar('tabFontWeight', '400'),
        'line-height': '1.45',
        'white-space': 'nowrap',
        'box-sizing': 'border-box',
        cursor: 'pointer',
        opacity: '1'
      });
      button.style.setProperty('border-radius', cssVar('tabRadius', '999px'), 'important');

