    return !Number.isNaN(opacity) && opacity >= 0.9;
  }

  function getTitleTextEl(root) { return root.querySelector('div[data-root="true"][placeholder="제목없음"]'); }
  function getTitleWrapEl(root) {
    const textEl = getTitleTextEl(root);
    if (!textEl) return null;
    const link = textEl.closest('a');
    return link ? link.parentElement : textEl.parentElement;
  }
  function getLabel(root) {
    const textEl = getTitleTextEl(root);
    return textEl ? textEl.textContent.trim() : '';
  }
  function getBlockId(root) { return root.getAttribute('data-block-id') || ''; }

  /* ================================================================
     2. 설정값 결정
     ================================================================ */

  function resolveConfig(root) {
    const setting = (typeof window.tabDbSetting_q9X === 'object' && window.tabDbSetting_q9X) || {};
    const builtInDefault = {
      titleVisible: true, tabVisible: true, mode: 'scroll', mobileMode: null,
      overThresholdMode: null, threshold: 0, wheelScroll: true, wheelSpeed: 1, moreLabel: '더보기'
    };
    const defaults = Object.assign({}, builtInDefault, setting.defaults || {});
    const exceptions = Array.isArray(setting.exceptions) ? setting.exceptions : [];
    const label = getLabel(root);
    const blockId = getBlockId(root);
    const matched = exceptions.find(ex => {
      if (ex.blockId) return ex.blockId === blockId;
      if (ex.label) return ex.label === label;
      return false;
    });
    return Object.assign({}, defaults, matched || {});
  }

  function pickMode(root, config) {
    const isMobile = window.innerWidth <= MOBILE_BREAKPOINT;
    let mode = config.mode;
    if (isMobile && config.mobileMode) mode = config.mobileMode;
    if (config.threshold > 0 && getTabs(root).length > config.threshold && config.overThresholdMode) {
      mode = config.overThresholdMode;
    }
    return ['scroll', 'wrap', 'more-dropdown', 'select'].includes(mode) ? mode : 'scroll';
  }

  /* ================================================================
     3. 호버 CSS
     ================================================================ */

  function ensureHoverStyle() {
    if (document.getElementById(HOVER_STYLE_ID)) return;
    const style = document.createElement('style');
    style.id = HOVER_STYLE_ID;
    style.textContent = `
      .${MARK}-btn {
        transition: ${cssVar('tabHoverSpeed', '160ms ease')} !important;
      }
      .${MARK}-btn[data-hover-off_q9X="1"] {
        transition: none !important;
      }
      .${MARK}-btn:not([data-hover-off_q9X="1"]):not([data-active_q9X="1"]):hover {
        background: ${cssVar('tabHoverBg', 'transparent')} !important;
        color: ${cssVar('tabHoverTextColor', 'inherit')} !important;
        transform: translateY(calc(-1 * ${cssVar('tabHoverLift', '0px')})) !important;
      }
      .${MARK}-btn:not([data-hover-off_q9X="1"]):not([data-active_q9X="1"]):hover * {
        color: inherit !important;
      }
    `;
    document.head.appendChild(style);
  }

  /* ================================================================
     4. 스타일 적용
     ================================================================ */

  function applyWrap(root) {
    setStyle(root, {
      border: cssVar('wrapBorder', 'none'),
      background: cssVar('wrapBg', 'transparent'),
      'border-radius': cssVar('wrapRadius', '0px'),
      'box-shadow': cssVar('wrapShadow', 'none'),
      'box-sizing': 'border-box',
      overflow: 'hidden'
    });
    if (getComputedStyle(root).position === 'static') root.style.setProperty('position', 'relative');
  }

  function applyTitle(root, config) {
    const wrapEl = getTitleWrapEl(root);
    if (!wrapEl) return;
    if (config.titleVisible === false) wrapEl.style.setProperty('display', 'none', 'important');
    else wrapEl.style.removeProperty('display');
  }

  function applyTabVisibility(tablist, config) {
    const box = getTablistBox(tablist);
    if (!box) return;
    if (config.tabVisible === false) box.style.setProperty('display', 'none', 'important');
    else box.style.removeProperty('display');
  }

  function applyTablistBox(tablist) {
    const box = getTablistBox(tablist);
    if (!box) return;
    setStyle(box, {
      height: 'auto', 'max-height': 'none', 'min-height': '0',
      'box-shadow': cssVar('tabDividerLine', 'none'), 'box-sizing': 'border-box'
