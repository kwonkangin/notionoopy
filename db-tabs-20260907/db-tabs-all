/*
  ==================================================================
  [그룹 7] 데이터베이스별 세부 설정 (JS 객체)
  ------------------------------------------------------------------
  위 :root 변수들은 "생김새(색상, 크기, 여백 등)"를 정하고, 이 객체는
  "동작 방식과 노출 여부"를 정합니다. 사이트에 데이터베이스(탭이 달린
  갤러리/표 등)가 여러 개 있을 때, 전부에 공통 적용할 기본값(defaults)과
  특정 데이터베이스만 다르게 할 예외(exceptions)를 나눠서 관리합니다.
  ==================================================================
*/
window.tabDbSetting_q9X = {

  /* ---------------- defaults: 모든 데이터베이스에 공통 적용되는 기본값 ---------------- */
  defaults: {

    /* 데이터베이스 제목 영역(아이콘+텍스트) 노출 여부
