    const hoverOn = flagOn(root, 'tabHoverToggle');
    const iconOn = flagOn(root, 'tabIconToggle');
    const underlineOn = flagIs(root, 'activeUnderlineToggle', '1');

    getTabs(root).forEach(tab => {
