    removeStyle(tablist, ['overflow', 'overflow-x', 'overflow-y', 'flex-wrap', 'height', 'max-height']);
    getTabs(state.root).forEach(tab => tab.style.removeProperty('display'));
    if (state.moreButton) state.moreButton.remove();
    if (state.moreMenu) state.moreMenu.remove();
    if (state.selectButton) state.selectButton.remove();
    if (state.selectMenu) state.selectMenu.remove();
    state.moreButton = null; state.moreMenu = null; state.selectButton = null; state.selectMenu = null;
    tablist.style.removeProperty('display');
  }

  function applyPopupButtonStyle(el) {
    setStyle(el, {
      background: cssVar('overflowBtnBg', '#fff'),
      border: cssVar('overflowBtnBorder', '1px solid rgba(55,53,47,0.16)'),
      color: cssVar('overflowTextColor', '#37352f'),
      'font-size': cssVar('overflowFontSize', '14px'),
      'box-sizing': 'border-box', cursor: 'pointer'
    });
    el.style.setProperty('border-radius', cssVar('overflowBtnRadius', '6px'), 'important');
  }

  function applyPopupMenuStyle(el) {
    setStyle(el, {
      background: cssVar('overflowMenuBg', '#fff'),
      border: cssVar('overflowMenuBorder', '1px solid rgba(55,53,47,0.16)'),
      'box-shadow': cssVar('overflowMenuShadow', 'none'),
      color: cssVar('overflowTextColor', '#37352f'),
      'font-size': cssVar('overflowFontSize', '14px'),
