      'align-items': 'center', 'justify-content': 'space-between', gap: '8px',
      margin: `${cssVar('tabListPadTop', '0px')} ${cssVar('tabListPadX', '16px')} ${cssVar('tabListPadBottom', '0px')} ${cssVar('tabListPadX', '16px')}`
    });
    applyPopupButtonStyle(button);

    const label = document.createElement('span');
    label.textContent = activeTab ? (activeTab.querySelector('span') ? activeTab.querySelector('span').textContent.trim() : activeTab.textContent.trim()) : '';
    setStyle(label, { overflow: 'hidden', 'text-overflow': 'ellipsis', 'white-space': 'nowrap' });

    const icon = document.createElement('span');
    icon.textContent = '\u25BE';
    button.append(label, icon);

    const menu = document.createElement('div');
    setStyle(menu, { position: 'absolute', display: 'none', 'z-index': '1000', padding: '6px', 'max-height': cssVar('overflowMenuMaxHeight', '280px'), 'overflow-y': 'auto' });
    applyPopupMenuStyle(menu);

    tabs.forEach(tab => addPopupItem(menu, tab, tab === activeTab, () => { clickTab(tab); label.textContent = tab.querySelector('span') ? tab.querySelector('span').textContent.trim() : tab.textContent.trim(); menu.style.display = 'none'; }));

    button.addEventListener('pointerdown', e => {
      e.preventDefault(); e.stopPropagation();
      if (menu.style.display === 'none') {
        const btnRect = button.getBoundingClientRect();
        const rootRect = state.root.getBoundingClientRect();
        setStyle(menu, { top: `${btnRect.bottom - rootRect.top + 4}px`, left: `${btnRect.left - rootRect.left}px`, width: `${btnRect.width}px` });
        menu.style.display = 'block';
      } else menu.style.display = 'none';
    });

    state.tablist.parentElement.insertBefore(button, state.tablist);
    state.root.appendChild(menu);
    state.selectButton = button; state.selectMenu = menu;
  }

  function wheelAllowed(state) { return state.config.wheelScroll !== false; }
  function bindWheel(state) {
    if (state.wheelBound) return;
    state.tablist.addEventListener('wheel', e => {
      if (!wheelAllowed(state)) return;
      if (!['scroll', 'more-dropdown'].includes(state.mode)) return;
      const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      if (!delta) return;
      e.preventDefault();
      state.tablist.scrollLeft += delta * (state.config.wheelSpeed || 1);
    }, { passive: false });
    state.wheelBound = true;
  }

  /* ================================================================
     6. 전체 적용 + 감시
     ================================================================ */

  function applyAll(state) {
    const tablist = getTablist(state.root);
    if (!tablist) return;
    state.tablist = tablist;
    state.config = resolveConfig(state.root);

    applyWrap(state.root);
    applyTitle(state.root, state.config);
    applyTabList(state.root);
    applyTabVisibility(tablist, state.config);
    applyTabs(state.root);

    resetOverflow(state);
    state.mode = pickMode(state.root, state.config);
    if (state.mode === 'wrap') applyWrapMode(state);
    else if (state.mode === 'more-dropdown') applyMoreMode(state);
    else if (state.mode === 'select') applySelectMode(state);
    else applyScrollMode(state);

    applyTablistBox(tablist);
    applyTabVisibility(tablist, state.config);
  }

  function scheduleApply(state) {
    if (state.frame) cancelAnimationFrame(state.frame);
    state.frame = requestAnimationFrame(() => { state.frame = 0; applyAll(state); });
  }

  function initRoot(root) {
    if (initedRoots.has(root)) return;
    const tablist = getTablist(root);
    if (!tablist) return;

    const state = { root, tablist, wheelBound: false, moreButton: null, moreMenu: null, selectButton: null, selectMenu: null, frame: 0 };
    initedRoots.add(root);
    allStates.push(state);

    ensureHoverStyle();
    applyAll(state);

    new ResizeObserver(() => scheduleApply(state)).observe(root);

    new MutationObserver(records => {
      const relevant = records.some(r => {
        if (r.type === 'attributes' && (r.attributeName === 'tabindex' || r.attributeName === 'style')) return true;
        if (r.type === 'childList') return true;
        return false;
      });
      if (relevant) scheduleApply(state);
    }).observe(tablist, { subtree: true, childList: true, attributes: true, attributeFilter: ['tabindex', 'style'] });

    document.addEventListener('pointerdown', e => {
      const menus = [state.moreMenu, state.selectMenu].filter(Boolean);
      const buttons = [state.moreButton, state.selectButton].filter(Boolean);
      const onButton = buttons.some(b => b === e.target || b.contains(e.target));
      menus.forEach(menu => {
        if (menu.style.display !== 'none' && !menu.contains(e.target) && !onButton) menu.style.display = 'none';
      });
    });
  }

  function scan() { findRoots().forEach(initRoot); }

  function boot() {
    ensureHoverStyle();
    scan();
    new MutationObserver(() => scan()).observe(document.body, { childList: true, subtree: true });

    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      if (resizeFrame) cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => { resizeFrame = 0; allStates.forEach(scheduleApply); });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  window.efc_findGalleryTitle_q9X = getLabel;
  window.efc_findGalleryBlockId_q9X = getBlockId;
  /* 대시보드에서 tabDbSetting_q9X 를 실시간으로 바꾼 뒤 즉시 반영을
     요청할 때 사용하는 재적용 훅 */
  window.efc_reapplyAllTabs_q9X = () => allStates.forEach(scheduleApply);
})();


</script>

