        svg.style.setProperty('fill', 'currentColor', 'important');
        svg.style.setProperty('flex-shrink', '0');
        svg.style.setProperty('display', iconOn ? '' : 'none');
        if (iconOn) {
          svg.style.setProperty('width', cssVar('tabIconSize', '14px'));
          svg.style.setProperty('height', cssVar('tabIconSize', '14px'));
        }
      });
    });
