  }

  function applyTabList(root) {
    const tablist = getTablist(root);
    if (!tablist) return;
    setStyle(tablist, {
      display: 'flex',
      'align-items': 'center',
      padding: `${cssVar('tabListPadTop', '0px')} ${cssVar('tabListPadX', '16px')} ${cssVar('tabListPadBottom', '0px')} ${cssVar('tabListPadX', '16px')}`,
      gap: `${cssVar('tabGapY', '8px')} ${cssVar('tabGapX', '12px')}`,
      'justify-content': cssVar('tabAlign', 'flex-start'),
      'box-sizing': 'border-box',
      width: '100%'
