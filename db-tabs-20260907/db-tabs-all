    if (!hidden.length) return;
    hidden.forEach(tab => tab.style.setProperty('display', 'none'));

    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = `${state.config.moreLabel} \u25BE`;
    setStyle(button, { 'margin-left': '4px', padding: '6px 12px', 'white-space': 'nowrap', 'flex-shrink': '0' });
    applyPopupButtonStyle(button);

