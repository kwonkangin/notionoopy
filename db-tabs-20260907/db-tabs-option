<script>

/*
  ==================================================================
  [그룹 7] 데이터베이스별 세부 설정 (JS 객체)
  ------------------------------------------------------------------
  위 :root 변수들은 "생김새(색상, 크기, 여백 등)"를 정하고, 이 객체는
  "동작 방식과 노출 여부"를 정합니다. 사이트에 데이터베이스(탭이 달린
  갤러리/표 등)가 여러 개 있을 때, 전부에 공통 적용할 기본값(defaults)과
  특정 데이터베이스만 다르게 할 예외(exceptions)를 나눠서 관리합니다.
  ==================================================================
*/
window.tabDbSetting_q9X = {

  /* ---------------- defaults: 모든 데이터베이스에 공통 적용되는 기본값 ---------------- */
  defaults: {

    /* 데이터베이스 제목 영역(아이콘+텍스트) 노출 여부
       기본값: true (보이게 둠)
       선택 가능 값:
       - true  : 화면에 표시
       - false : 완전히 제거 (그 자리 공간도 없어지고 아래 콘텐츠가 당겨져 채움)
       주의: Notion에서 이미 "제목 비노출"로 꺼둔 데이터베이스는 애초에
       DOM에 제목 요소가 없어서 이 옵션이 적용될 대상 자체가 없습니다.
       (즉 이 옵션은 Notion에서 "제목 노출"로 켜둔 데이터베이스에만 의미 있음) */
    titleVisible: true,

    /* 탭 목록(줄) 자체의 노출 여부
       기본값: true (보이게 둠)
       선택 가능 값: true(표시) / false(탭 줄 전체를 통째로 숨김, 아래
       콘텐츠만 보이게 됨) */
    tabVisible: true,

    /* 탭이 많아서 한 줄에 다 안 들어갈 때(PC 기준) 처리 방식
       기본값: 'scroll'
       선택 가능 값:
       - 'scroll'        가로로 밀어서 스크롤 (탭 줄은 한 줄 유지)
       - 'wrap'          다음 줄로 자동 줄바꿈
       - 'more-dropdown' 넘치는 탭들을 "더보기" 버튼 안 드롭다운으로 숨김
       - 'select'        탭 목록 전체를 셀렉트박스(선택창) 하나로 대체 */
    mode: 'scroll',

    /* 모바일(가로 폭 768px 이하) 전용 처리 방식
       기본값: null
       선택 가능 값: 'scroll' / 'wrap' / 'more-dropdown' / 'select' / null
       null로 두면 모바일에서도 위 mode 값을 그대로 따라갑니다.
       모바일에서만 다르게 하고 싶을 때만 값을 채우세요. */
    mobileMode: null,

    /* 탭 개수가 threshold 값을 초과했을 때만 강제로 바꿀 처리 방식
       기본값: null (사용 안 함)
       선택 가능 값: 위 mode와 동일 4가지, 또는 null */
    overThresholdMode: null,

    /* overThresholdMode를 적용할 탭 개수 기준
       기본값: 0 (0이면 이 기능 자체를 사용하지 않음)
       입력 형식: 정수 (예: 6 → 탭이 7개 이상일 때부터 overThresholdMode 적용) */
    threshold: 0,

    /* 마우스 휠로 탭 목록을 가로 스크롤할 수 있게 할지 여부
       (mode가 'scroll' 또는 'more-dropdown'일 때만 의미 있음)
       기본값: true
       선택 가능 값: true(켜기) / false(끄기) */
    wheelScroll: true,

    /* 마우스 휠 스크롤 속도 배율
       기본값: 1 (기본 속도)
       입력 형식: 양수. 2로 하면 2배 빠르게, 0.5면 절반 속도 */
    wheelSpeed: 1,

    /* "더보기" 버튼에 표시할 글자
       기본값: '더보기'
       입력 형식: 원하는 문자열 아무거나 (예: 'More', '전체보기') */
    moreLabel: '더보기'
  },

  /* ---------------- exceptions: 특정 데이터베이스만 다르게 할 예외 목록 ---------------- */
  /* 배열 안에 객체를 하나씩 추가해서, 그 데이터베이스만 위 defaults와
     다른 값을 쓰게 만듭니다. 적지 않은 항목은 defaults 값을 그대로
     사용합니다. 데이터베이스 하나당 객체는 하나만 만들면 되고, 그 안에
     바꾸고 싶은 항목을 원하는 만큼 같이 적으면 됩니다.

     label      : 예외를 적용할 데이터베이스의 이름표.
                  Notion에서 "제목 노출" 상태인 데이터베이스에만 사용
                  가능하며, 화면에 보이는 제목 텍스트와 정확히(띄어쓰기
                  포함) 일치해야 합니다.
     blockId    : Notion에서 "제목 비노출" 상태인 데이터베이스는 라벨
                  텍스트 자체가 DOM에 없으므로 반드시 이 값을 사용해야
                  합니다. 같은 이름의 데이터베이스가 두 개 이상 있어서
                  label만으로 구분이 안 될 때도 사용합니다.
                  (Notion에서 해당 데이터베이스 블록을 우클릭 > 링크
                  복사로 얻은 주소 끝부분의 블록 ID를 넣으면 됩니다)
                  label을 쓸 경우 blockId는 빈 문자열로, blockId를 쓸
                  경우 label은 빈 문자열로 비워두세요. (하나만 채우면 됨)
     그 외 항목 : defaults와 이름이 같은 항목(titleVisible, tabVisible,
                  mode, mobileMode, overThresholdMode, threshold,
                  wheelScroll, wheelSpeed, moreLabel) 중 이 데이터베이스만
                  다르게 하고 싶은 값만 적으면 됩니다. */
  exceptions: [
    // 예시 (제목이 보이는 데이터베이스 하나에, 제목 숨기기 + 오버플로우
    // 모드 변경을 동시에 적용하는 경우)
    // {
    //   label: '데이터베이스명',
    //   blockId: '',
    //   titleVisible: false,
    //   tabVisible: true,
    //   mode: 'wrap'
    // }
  ]
};

</script>